#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.11"
# dependencies = [
#   "typer>=0.12",
#   "rich>=13",
#   "python-frontmatter>=1.1",
#   "pyyaml>=6",
# ]
# ///
"""
knowledge — external temporal knowledge graph for agent-maintained memory.

One fact per file, schema-validated frontmatter, tf-idf duplicate detection.

Nothing about a particular organisation is compiled in. The store location,
the vocabulary for `scope:`, the similarity thresholds, and the identifier
classes used by the entity guard all come from a `.knowledge.yml` discovered by
walking up from the working directory. Run `knowledge init` to create one.
"""

from __future__ import annotations

import hashlib
import json
import math
import os
import re
import sqlite3
import subprocess
import sys
import uuid
from datetime import date, datetime, timezone
from pathlib import Path
from typing import Optional

import frontmatter
import typer
import yaml
from rich.console import Console
from rich.prompt import Prompt
from rich.table import Table

CONFIDENCE_VALUES = {"high", "medium", "low"}
PROVENANCE_VALUES = {"user-stated", "inferred"}
EPISTEMIC_STATUS_VALUES = {"supported", "contested", "refuted", "unknown", "superseded"}
VALIDATION_OUTCOMES = {"supported", "contradicted", "unknown", "not_applicable"}

# Pending candidates live as .yml so a markdown indexer (**/*.md) never picks up
# unconfirmed model output, and so all_facts() (*.md, non-recursive) ignores them.
PENDING_SUBDIR = "pending"
REJECTED_SUBDIR = "pending/rejected"
# Pruning moves entries here rather than deleting them. A candidate aging out
# means review didn't keep up, which is not a judgement that the claim was
# wrong, so the text survives where `pending --archived` can still find it.
ARCHIVED_SUBDIR = "pending/archived"
# Episodes are append-only, untrusted source material. They live in the external
# store, never in a repository being described, and never enter unattended
# recall. Assertions may cite them; they are not assertions themselves.
EPISODES_SUBDIR = "episodes"
# Read events land here. Dotfile so note tools that index `*.md` skip it.
USAGE_LOG_NAME = ".usage.jsonl"
# Transaction and validation history are append-only. The current Markdown fact
# files remain the human-readable view; these logs retain how that view changed.
EVENT_LOG_NAME = ".events.jsonl"
VALIDATION_LOG_NAME = ".validations.jsonl"

CONFIG_FILENAME = ".knowledge.yml"
USER_CONFIG = Path.home() / ".config/knowledge/config.yml"

# Defaults for a store that has no config yet. The thresholds are the ones that
# measured best on a ~340-document corpus; they are a starting point, not a
# constant of nature. `knowledge tune` re-derives them from your own review
# history, which is the only way to know what they should be for your corpus.
DEFAULTS: dict = {
    "store": str(Path.home() / ".local/share/knowledge"),
    "scopes": ["personal"],
    "prefixed_scopes": ["repo", "task"],
    "thresholds": {
        # tf-idf cosine at or above this is refused by `propose` as a duplicate.
        # Strictest of the three on purpose: refusing is destructive.
        "duplicate_cosine": 0.55,
        # Between related and duplicate the candidate is queued anyway, with its
        # neighbours recorded in `near:` so review can group them.
        "related_cosine": 0.42,
        # Grouping cutoff for `dupes`. Loosest, because review acts per cluster:
        # a loose group costs a keystroke to split, a missed duplicate costs a
        # second confirmed fact saying the same thing.
        "cluster_cosine": 0.38,
        # Legacy Jaccard gate, kept as a cheap catch for near-verbatim copies.
        # Nearly useless against paraphrase, which is why cosine exists.
        "duplicate_jaccard": 0.75,
        # Floor for `recall`, against its blended score rather than raw cosine.
        # Recall runs unattended, so it errs toward silence: a miss costs one
        # un-recalled fact, a false positive taxes attention on every prompt.
        "recall_min_score": 0.25,
    },
    # Identifier classes for the entity guard. See entity_conflict().
    "entities": [],
    # Repository roots are only lookup hints for validators. Neither facts nor
    # graph indexes are written into repositories under these roots.
    "repo_roots": [],
    # The SQLite graph is a disposable projection. By default it lives in a
    # cache keyed by the external store path, never beside application code.
    "graph_cache": str(Path.home() / ".cache/knowledge"),
    # Distinctive shared tokens a fact needs before `recall` will surface it.
    "recall_min_shared": 1,
    # Vocabulary too generic to justify a recall hit on its own. These still
    # count toward the score; they just can't be the whole reason a fact fired.
    #
    # Why a list and not idf: in a store of a few hundred facts about one
    # organisation, "config" and the name of your deploy tool have the same
    # document frequency, so idf cannot tell domain vocabulary from filler.
    # Measured on real prompts, score, matched idf mass and token rarity all
    # failed to separate "did you do the config file thing too?" from a genuine
    # question. Which tokens matched is the only thing that separates them.
    # Extend this when recall fires on filler; that is the maintenance surface.
    "recall_generic": """
config configs configuration file files folder dir directory script scripts code repo repos
repository run runs running write writes writing update updates updated updating check checks
checking change changed changes fix fixes fixed add adds added remove removes removed delete
test tests testing python bash typescript javascript golang rust java yaml json markdown
week weeks day days month months today yesterday tomorrow again also please thanks thank
task tasks job jobs project projects work works working stuff bit thing done need needs
want wants look looks looking see sees show shows tell say says ask asks help helps
""".split(),
    "stale_days": 90,
    "pending_prune_days": 45,
    "rejected_prune_days": 180,
}

PROTOCOL_DOC = """# knowledge: the agent protocol

Paste this into your agent instructions (`AGENTS.md`, `CLAUDE.md`). The CLI
enforces schema and duplicate checks; everything below is the part it cannot
enforce, and shipping the tool without it produces a landfill.

## Three layers, and the distinction is load-bearing

| Layer | Command | Trusted/citable? |
|---|---|---|
| Episode (`episodes/**/*.yml`) | `knowledge ingest` | No — raw evidence only |
| Candidate (`pending/*.yml`) | `knowledge propose` | No — leads only |
| Assertion (`*.md`) | `knowledge confirm` | Yes, subject to status/time |

All three live in the external knowledge store. Repository awareness comes from
canonical repo, commit, path, and symbol references; never write memory or graph
state into a repository being described. The SQLite graph is a disposable
projection under the configured cache.

Episodes and candidates are YAML outside the Markdown fact set, so an indexer
never launders unreviewed model output into unattended recall.

## Writing

Use `knowledge ingest` without a numeric cap for potentially reusable source
material. Ingestion is append-only, untrusted, and does not run duplicate checks.
Use `knowledge propose` for an atomic assertion derived from one or more episodes;
`add`, `confirm`, and `reject` belong to the human. Capture volume is controlled
by trust-aware retrieval and consolidation, not by throwing observations away.

Two provenance tiers, tagged differently because they age differently:

- `--provenance user-stated` — a person said it. Quote them in `--evidence`.
  Corrections to your assumptions, explicit "remember this", and declarative
  present-tense facts about how things work.
- `--provenance inferred` — you worked it out from code, docs, or a fetch. Put
  the source in `--evidence` (`path/to/file.yaml:12`) so it can be checked
  without re-deriving.

An inferred candidate whose evidence line does not let a reviewer verify it is
worse than no candidate: it costs a research trip. Hold that bar.

**Never store**: secrets, keys, tokens, one-off task status, speculation, or
anything you would want to read as prose. Long-form reasoning belongs in dated
session notes. A fact is one sentence you want surfaced when an agent touches
related work.

## Reading

The store is useless if you do not consult it. Before asserting ownership,
topology, conventions, or "how do we do X" — check first.

- `knowledge topics` / `knowledge list --topic <t>` — what exists
- `knowledge get <id>` — the body plus frontmatter
- `knowledge graph-neighbors <entity>` — typed relations around an entity
- `knowledge index` — one line per fact; use sparingly

Frontmatter is load-bearing when you read a fact:

- `confidence: low` — a hint, not authority. Verify before acting.
- `last_verified_at` older than `stale_days`, or `valid_until` past — surface the
  fact **and** flag the staleness. Do not rely on it silently.
- `invalidated_at` set — do not use it. The file is kept only for audit.
- `epistemic_status: unknown|contested|refuted|superseded` — surface the status;
  refuted and superseded assertions are excluded from recall.
- `verified: pending` in a listing — an unvetted candidate. Read it as a lead to
  check, never as an answer to give, and never propose a new fact derived from
  one. That laundering is how inference becomes "fact" one hop at a time.

Provenance predicts reliability better than confidence does, because confidence
is self-assigned by whatever wrote the fact.

## Contradictions

If you observe something that contradicts a stored fact, run
`knowledge invalidate <id> --reason "<what you saw>"` and say one line about it,
then propose the replacement. Do not silently work around a stale fact.

`knowledge sweep` runs configured deterministic validators. Missing repositories
or unavailable evidence produce `unknown`, never `refuted`; only authoritative
contradictory evidence may refute an assertion. Validation history is append-only.

## Review

Duplicates are a correctness signal, not clutter. When `knowledge dupes` groups
candidates that restate one claim while naming *different* magnitudes for the
same quantity, most of them are wrong — the merged fact should usually state no
number rather than pick one. Reject with a reason naming the survivor: it blocks
re-proposal, and it is the labelled data `knowledge tune` learns thresholds from.
"""


_CONFIG: Optional[dict] = None
_STORE_OVERRIDE: Optional[Path] = None


def find_config_file(start: Optional[Path] = None) -> Optional[Path]:
    """Nearest .knowledge.yml walking up from `start`, else the user config.

    Walking up from the working directory is the convention every other dev tool
    uses, but it is a weak anchor for agent work: agents frequently run in
    scratch directories that sit under no project at all. The user-level config
    is the backstop for exactly that case.
    """
    here = (start or Path.cwd()).resolve()
    for d in [here, *here.parents]:
        cand = d / CONFIG_FILENAME
        if cand.is_file():
            return cand
    return USER_CONFIG if USER_CONFIG.is_file() else None


def _merge_config(cfg: dict, path: Path) -> None:
    """Overlay one config file onto cfg, in place."""
    # A broken config must be fatal. Degrading to defaults would silently
    # relocate the store and silently disable the entity guard, and the
    # symptom — facts filed somewhere unexpected, duplicates reappearing —
    # shows up far from the typo that caused it.
    try:
        data = yaml.safe_load(path.read_text())
    except (OSError, yaml.YAMLError) as e:
        err_console.print(f"[red]Cannot read {path}[/red]\n{e}")
        raise typer.Exit(2)
    if data is None:
        data = {}
    if not isinstance(data, dict):
        err_console.print(f"[red]{path} must contain a YAML mapping[/red], got {type(data).__name__}")
        raise typer.Exit(2)
    for k, v in data.items():
        if k == "thresholds" and isinstance(v, dict):
            cfg["thresholds"].update(v)
        else:
            cfg[k] = v
    if "store" in data:
        # relative store paths resolve against the config file, so a repo can
        # carry its store alongside its config. expanduser FIRST: `~/notes`
        # is absolute to a human, and `path.parent / "~/notes"` silently
        # yields `<configdir>/~/notes`, a directory that will never exist.
        raw = Path(str(data["store"]).strip()).expanduser()
        cfg["store"] = str(raw.resolve() if raw.is_absolute()
                           else (path.parent / raw).resolve())
        # Which file actually decided the store, as distinct from the whole
        # merge chain — otherwise `config` reports both and explains neither.
        cfg["_store_source"] = str(path)


def _build_config(paths: list[Path]) -> dict:
    cfg = json.loads(json.dumps(DEFAULTS))     # deep copy of plain data
    for path in paths:
        _merge_config(cfg, path)
    cfg["_source"] = ", ".join(str(p) for p in paths) if paths else "built-in defaults"
    return cfg


def _resolve_store(cfg: dict) -> tuple[Path, str]:
    """Store path precedence: explicit flag > env > config > default."""
    if _STORE_OVERRIDE:
        return _STORE_OVERRIDE, "--store"
    if os.environ.get("KNOWLEDGE_DIR"):
        return Path(os.environ["KNOWLEDGE_DIR"]).expanduser(), "KNOWLEDGE_DIR"
    return Path(cfg["store"]).expanduser(), cfg.get("_store_source") or cfg["_source"]


def load_config(reload: bool = False) -> dict:
    global _CONFIG
    if _CONFIG is not None and not reload:
        return _CONFIG

    # settings: prefer a config sitting in the store, then the nearest one
    store_hint = _STORE_OVERRIDE or (
        Path(os.environ["KNOWLEDGE_DIR"]).expanduser() if os.environ.get("KNOWLEDGE_DIR") else None
    )
    if store_hint and (store_hint / CONFIG_FILENAME).is_file():
        picked = store_hint / CONFIG_FILENAME
    else:
        picked = find_config_file()

    cfg = _build_config([picked] if picked else [])
    store, store_from = _resolve_store(cfg)

    # The store owns its settings. A config that merely NAMES a store — the
    # user-level pointer, or one at the root of a source tree — would otherwise
    # leave scope vocabulary, thresholds and the entity guard at their defaults,
    # which is the same silent degradation that makes a malformed config fatal:
    # `--scope <yours>` starts getting rejected and the entity guard goes inert,
    # with nothing said. So the store's own config is the base, and whatever
    # named it overlays on top.
    store_cfg = store / CONFIG_FILENAME
    if store_cfg.is_file() and (picked is None or store_cfg.resolve() != picked.resolve()):
        cfg = _build_config([store_cfg] + ([picked] if picked else []))
        store, store_from = _resolve_store(cfg)

    cfg["store"] = str(store)
    cfg["_store_from"] = store_from
    _CONFIG = cfg
    return cfg


def thresh(name: str) -> float:
    return float(load_config()["thresholds"][name])


app = typer.Typer(
    add_completion=False,
    no_args_is_help=True,
    help="Atomic-fact CLI. Configuration is discovered, not compiled in.",
)
console = Console()
err_console = Console(stderr=True)


@app.callback()
def main_callback(
    store: Optional[Path] = typer.Option(
        None, "--store", "-S",
        help="Store directory. Overrides KNOWLEDGE_DIR and any discovered .knowledge.yml.",
    ),
) -> None:
    """Atomic-fact CLI. Configuration is discovered, not compiled in."""
    global _STORE_OVERRIDE
    if store is not None:
        _STORE_OVERRIDE = store.expanduser().resolve()
        load_config(reload=True)


# -------- paths & io --------

def knowledge_dir(must_exist: bool = True) -> Path:
    """The store directory.

    A missing store is fatal by default. Reading it as an empty store instead
    turns a one-character config typo into "0 fact(s)", which is indistinguishable
    from having lost the store — and the error surfaces nowhere near the typo.
    """
    cfg = load_config()
    path = Path(cfg["store"]).expanduser()
    if must_exist and not path.is_dir():
        err_console.print(
            f"[red]Store directory does not exist:[/red] {path}\n"
            f"[dim]resolved by {cfg.get('_store_from')} (settings: {cfg.get('_source')})\n"
            f"Fix the `store:` path, pass --store, or run `knowledge init` to create one.[/dim]"
        )
        raise typer.Exit(2)
    return path


def fact_path(fact_id: str) -> Path:
    return knowledge_dir() / f"{fact_id}.md"


def all_facts() -> list[tuple[str, frontmatter.Post]]:
    """Every stored fact.

    A fact is markdown carrying an `id` in its frontmatter — not merely any
    `.md` in the directory. The store legitimately holds prose that is not a
    fact: a README, and the AGENTS-knowledge.md that `init` writes when the
    config lives in the store. Globbing `*.md` counted those as facts, so a
    freshly initialised, entirely empty store reported one.
    """
    out = []
    for p in sorted(knowledge_dir().glob("*.md")):
        post = frontmatter.load(p)
        if not post.get("id"):
            continue
        out.append((p.stem, post))
    return out


def load_fact(fact_id: str) -> frontmatter.Post:
    p = fact_path(fact_id)
    if not p.exists():
        err_console.print(f"[red]No such fact:[/red] {fact_id}")
        raise typer.Exit(2)
    return frontmatter.load(p)


def save_fact(fact_id: str, post: frontmatter.Post) -> None:
    fact_path(fact_id).write_bytes(frontmatter.dumps(post, sort_keys=False).encode() + b"\n")



def pending_dir(create: bool = False) -> Path:
    p = knowledge_dir() / PENDING_SUBDIR
    if create:
        p.mkdir(parents=True, exist_ok=True)
    return p


def archived_dir(create: bool = False) -> Path:
    p = knowledge_dir() / ARCHIVED_SUBDIR
    if create:
        p.mkdir(parents=True, exist_ok=True)
    return p


def rejected_dir(create: bool = False) -> Path:
    p = knowledge_dir() / REJECTED_SUBDIR
    if create:
        p.mkdir(parents=True, exist_ok=True)
    return p


def load_yaml_dir(path: Path) -> list[tuple[str, dict]]:
    if not path.exists():
        return []
    out = []
    for p in sorted(path.glob("*.yml")):
        try:
            data = yaml.safe_load(p.read_text()) or {}
        except yaml.YAMLError:
            continue
        if isinstance(data, dict):
            out.append((p.stem, data))
    return out


def all_pending() -> list[tuple[str, dict]]:
    return load_yaml_dir(pending_dir())


def all_archived() -> list[tuple[str, dict]]:
    return load_yaml_dir(archived_dir())


def all_rejected() -> list[tuple[str, dict]]:
    return load_yaml_dir(rejected_dir())


def write_yaml(path: Path, data: dict) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(yaml.safe_dump(data, sort_keys=False, allow_unicode=True))


def utc_now_iso() -> str:
    return datetime.now(timezone.utc).isoformat(timespec="seconds").replace("+00:00", "Z")


def episodes_dir(create: bool = False) -> Path:
    p = knowledge_dir() / EPISODES_SUBDIR
    if create:
        p.mkdir(parents=True, exist_ok=True)
    return p


def all_episodes() -> list[tuple[str, dict]]:
    root = episodes_dir()
    if not root.exists():
        return []
    out: list[tuple[str, dict]] = []
    for p in sorted(root.rglob("*.yml")):
        try:
            data = yaml.safe_load(p.read_text()) or {}
        except yaml.YAMLError:
            continue
        if isinstance(data, dict) and data.get("id"):
            out.append((str(data["id"]), data))
    return out


def append_jsonl(name: str, record: dict) -> None:
    """Append audit data without allowing telemetry failure to lose the write."""
    try:
        with (knowledge_dir() / name).open("a", encoding="utf-8") as fh:
            fh.write(json.dumps(record, sort_keys=True) + "\n")
    except OSError as exc:
        err_console.print(f"[yellow]Could not append {name}:[/yellow] {exc}")


def append_event(kind: str, ident: str, **data) -> None:
    append_jsonl(EVENT_LOG_NAME, {
        "at": utc_now_iso(), "kind": kind, "id": ident, **data,
    })


def read_jsonl(name: str) -> list[dict]:
    path = knowledge_dir() / name
    if not path.exists():
        return []
    out: list[dict] = []
    for line in path.read_text(encoding="utf-8").splitlines():
        if not line.strip():
            continue
        try:
            row = json.loads(line)
        except json.JSONDecodeError:
            continue
        if isinstance(row, dict):
            out.append(row)
    return out


def graph_index_path() -> Path:
    """Disposable SQLite projection, external to every source repository."""
    cfg = load_config()
    if cfg.get("graph_index"):
        raw = Path(str(cfg["graph_index"])).expanduser()
        return raw if raw.is_absolute() else (knowledge_dir() / raw).resolve()
    digest = hashlib.sha256(str(knowledge_dir().resolve()).encode()).hexdigest()[:16]
    return Path(str(cfg["graph_cache"])).expanduser() / digest / "graph.sqlite3"


def write_episode(
    text: str,
    *,
    kind: str = "text",
    source: str = "",
    reference_time: str = "",
    repo: str = "",
    revision: str = "",
    branch: str = "",
    path: str = "",
    cwd: str = "",
) -> tuple[str, Path]:
    """Append an untrusted episode. There is deliberately no duplicate gate."""
    observed_at = utc_now_iso()
    eid = f"ep-{observed_at[:10].replace('-', '')}-{uuid.uuid4().hex[:12]}"
    record = {
        "id": eid,
        "kind": kind,
        "text": text,
        "source": source or f"session-{observed_at[:10]}",
        "observed_at": observed_at,
        "reference_time": reference_time or observed_at,
        "repo": repo,
        "revision": revision,
        "branch": branch,
        "path": path,
        "cwd": cwd or os.getcwd(),
        "trusted": False,
    }
    dest = episodes_dir(create=True) / observed_at[:7] / f"{eid}.yml"
    write_yaml(dest, record)
    append_event("episode.ingested", eid, repo=repo, revision=revision, path=path)
    return eid, dest


def migration_reference_time(data) -> str:
    """Best available valid-time hint for a legacy assertion's source episode."""
    for key in ("learned_at", "proposed_at", "last_verified_at", "recorded_at"):
        value = str(data.get(key) or "")
        if value:
            return value
    return ""


def migrate_episode(
    assertion_kind: str,
    assertion_id: str,
    text: str,
    data,
    *,
    dry_run: bool,
) -> tuple[str, bool, bool]:
    """Create one stable, untrusted source episode for a legacy assertion.

    The deterministic ID makes migration idempotent. The assertion body is
    explicitly labelled as legacy evidence rather than being represented as a
    newly observed source claim.
    """
    digest = hashlib.sha256(f"{assertion_kind}:{assertion_id}".encode()).hexdigest()[:16]
    eid = f"ep-migrated-{assertion_kind}-{digest}"
    dest = episodes_dir(create=not dry_run) / "migrated" / f"{eid}.yml"
    evidence = str(data.get("evidence") or "")
    source = evidence or str(data.get("source") or f"legacy {assertion_kind} assertion {assertion_id}")
    desired = {
        "kind": "legacy-assertion",
        "text": evidence or text,
        "source": source,
        "reference_time": migration_reference_time(data),
        "repo": str(data.get("repo") or ""),
        "revision": str(data.get("repo_revision") or ""),
        "path": str(data.get("repo_path") or ""),
        "trusted": False,
        "migration": {"assertion_kind": assertion_kind, "assertion_id": assertion_id},
    }
    if dest.exists():
        try:
            existing = yaml.safe_load(dest.read_text()) or {}
        except yaml.YAMLError:
            existing = {}
        updates = {key: value for key, value in desired.items()
                   if existing.get(key) != value and value != ""}
        if updates and not dry_run:
            existing.update(updates)
            write_yaml(dest, existing)
            append_event("episode.migration_repaired", eid, assertion_id=assertion_id)
        return eid, False, bool(updates)
    if dry_run:
        return eid, True, False
    observed_at = utc_now_iso()
    record = {
        "id": eid,
        **desired,
        "observed_at": observed_at,
        "reference_time": desired["reference_time"] or observed_at,
        "branch": "",
        "cwd": "",
    }
    write_yaml(dest, record)
    append_event("episode.migrated", eid, assertion_id=assertion_id, assertion_kind=assertion_kind)
    return eid, True, False


def migrate_legacy_store(*, include_pending: bool, dry_run: bool) -> dict[str, int]:
    """Backfill additive graph metadata without inferring semantic relations."""
    counts = {"facts_changed": 0, "pending_changed": 0, "episodes_created": 0, "episodes_updated": 0}

    for fid, post in all_facts():
        changed = False
        episodes = post.get("episodes")
        eid, created, updated = migrate_episode("fact", fid, post.content, post, dry_run=dry_run)
        counts["episodes_created"] += int(created)
        counts["episodes_updated"] += int(updated)
        if not isinstance(episodes, list) or not episodes:
            episodes = [eid]
            changed = True
        if not post.get("recorded_at"):
            post["recorded_at"] = utc_now_iso()
            changed = True
        if not post.get("epistemic_status"):
            # Human-confirmed legacy facts begin supported; invalidated facts
            # remain excluded independently by their existing invalidation flag.
            post["epistemic_status"] = "supported"
            changed = True
        if changed:
            post["episodes"] = episodes
            counts["facts_changed"] += 1
            if not dry_run:
                save_fact(fid, post)
                append_event("assertion.migrated", fid, assertion_kind="fact", episodes=episodes)

    if include_pending:
        for pid, data in all_pending():
            changed = False
            episodes = data.get("episodes")
            eid, created, updated = migrate_episode(
                "pending", pid, str(data.get("text") or ""), data, dry_run=dry_run,
            )
            counts["episodes_created"] += int(created)
            counts["episodes_updated"] += int(updated)
            if not isinstance(episodes, list) or not episodes:
                episodes = [eid]
                changed = True
            if not data.get("recorded_at"):
                data["recorded_at"] = str(data.get("proposed_at") or utc_now_iso())
                changed = True
            if changed:
                data["episodes"] = episodes
                counts["pending_changed"] += 1
                if not dry_run:
                    write_yaml(pending_dir(create=True) / f"{pid}.yml", data)
                    append_event("assertion.migrated", pid, assertion_kind="pending", episodes=episodes)
    return counts


def tokens(text: str) -> set[str]:
    return set(re.findall(r"[a-z0-9]+", (text or "").lower()))


def similarity(a: str, b: str) -> float:
    ta, tb = tokens(a), tokens(b)
    if not ta or not tb:
        return 0.0
    return len(ta & tb) / len(ta | tb)


# -------- entity guard --------
#
# Similarity metrics weight words by how common they are, so a shared sentence
# template drowns out the two rare tokens that carry the whole meaning. "The
# Data Platform team files its work in the Jira DPA project" and "The SecOps
# team files its work in the Jira SEC project" score 0.42 on tf-idf and rank
# each other #2 under embeddings. They are unrelated facts.
#
# So identifiers get a veto that runs before similarity is consulted. The rule
# is deliberately narrow: block only when each side names EXACTLY ONE
# identifier of a class and they differ. A fact naming one identifier is about
# that identifier; a fact listing several is illustrating with them, and those
# must stay mergeable — a real cluster legitimately merged members listing
# 'sales@, support@' with members listing 'billing@, ops@': disjoint alias sets
# illustrating one shared claim, not two competing ones.

# Identifier classes are configured, not compiled in. Each class names one
# kind of hard identifier that appears in your facts — a ticket key, a team
# slug, a hostname — and how to extract it. Example .knowledge.yml:
#
#   entities:
#     - name: ticket key
#       lowercase: false
#       patterns:
#         - '\b([A-Z]{2,6})-\d+\b'
#     - name: email
#       lowercase: true
#       patterns:
#         - '\b([a-z0-9][a-z0-9._-]{1,40})@'
#
# With no `entities` configured the guard is inert and similarity alone decides.

def _entity_classes() -> list[tuple[str, bool, list]]:
    out = []
    for spec in load_config().get("entities") or []:
        if not isinstance(spec, dict):
            continue
        name = str(spec.get("name") or "identifier")
        lower = bool(spec.get("lowercase", False))
        pats = []
        for raw in spec.get("patterns") or []:
            try:
                pats.append(re.compile(str(raw), re.I if lower else 0))
            except re.error as e:
                err_console.print(f"[yellow]bad entity pattern for '{name}': {e}[/yellow]")
        if pats:
            out.append((name, lower, pats))
    return out


def _extract(text: str, lower: bool, pats: list) -> set:
    hay = (text or "").lower() if lower else (text or "")
    found: set = set()
    for pat in pats:
        for m in pat.findall(hay):
            found.add((m if isinstance(m, str) else next((x for x in m if x), "")).strip())
    return {f for f in found if f}


def log_usage(action: str, ids: Optional[list[str]] = None, query: str = "", **extra) -> None:
    """Append one read event. Best-effort: telemetry must never break a lookup.

    Without this, curation can only prune by age, which says nothing about
    whether a fact ever changed an answer.
    """
    if os.getenv("KNOWLEDGE_USAGE_LOG", "1") == "0":
        return
    try:
        record = {"at": datetime.now().isoformat(timespec="seconds"),
                  "action": action, "ids": ids or []}
        if query:
            # Truncated deliberately: enough to see why a match fired, not a
            # transcript of everything the user ever typed.
            record["query"] = query[:200]
        record.update(extra)
        with (knowledge_dir() / USAGE_LOG_NAME).open("a", encoding="utf-8") as fh:
            fh.write(json.dumps(record) + "\n")
    except Exception:
        pass


def read_usage(days: Optional[int] = None) -> list[dict]:
    try:
        path = knowledge_dir() / USAGE_LOG_NAME
        if not path.exists():
            return []
        rows = []
        for line in path.read_text(encoding="utf-8").splitlines():
            if not line.strip():
                continue
            try:
                row = json.loads(line)
            except json.JSONDecodeError:
                continue
            if days is not None:
                at = str(row.get("at", ""))[:10]
                if not at or days_ago(at) > days:
                    continue
            rows.append(row)
        return rows
    except Exception:
        return []


def entity_conflict(a: str, b: str) -> Optional[str]:
    """Describe a single-identifier disagreement between two facts, if any."""
    for label, lower, pats in _entity_classes():
        A, B = _extract(a, lower, pats), _extract(b, lower, pats)
        if len(A) == 1 and len(B) == 1 and A != B:
            return f"{label}: {A.pop()} vs {B.pop()}"
    return None


def score_pairs(query: str, pairs: list[tuple[str, str]]) -> list[tuple[float, str, int]]:
    """Rank (id, text) pairs against a query. Returns (score, id, distinctive).

    Same tf-idf as the duplicate gate, scored for a different question. Dedupe
    asks "are these two statements the same?", where plain cosine is right.
    Recall asks "does this fact answer that question?", where cosine alone
    over-rewards a short fact sharing one rare token — "who owns the checkout
    service" matching a fact about `git checkout`. So the score is the geometric
    mean of cosine and query coverage (the share of the query's idf mass the
    fact accounts for), which demands the fact address the question rather than
    merely collide with it.

    The third element counts DISTINCTIVE shared tokens — those outside
    `recall_generic`. Generic tokens inform the ranking but can't be the whole
    reason a fact is eligible.
    """
    if not pairs:
        return []
    target = content_tokens(query)
    if not target:
        return []
    generic = set(load_config().get("recall_generic") or [])
    docs = [content_tokens(t) for _, t in pairs]
    idf = _idf(docs + [target])
    tv = _vec(target, idf)
    qset = set(target)
    qmass = sum(idf.get(w, 1.0) for w in qset) or 1.0
    out: list[tuple[float, str, int]] = []
    for (ident, _), d in zip(pairs, docs):
        cos = _cos(tv, _vec(d, idf))
        shared = qset & set(d)
        if not shared or cos <= 0:
            out.append((0.0, ident, 0))
            continue
        coverage = sum(idf.get(w, 1.0) for w in shared) / qmass
        out.append((math.sqrt(cos * coverage), ident, len(shared - generic)))
    out.sort(key=lambda r: -r[0])
    return out


def fact_status(post: frontmatter.Post) -> str:
    """Freshness marker. Recall prints this inline so a stale fact can't be read
    as current just because retrieval happened to like it."""
    epistemic = str(post.get("epistemic_status") or "supported")
    if epistemic != "supported":
        return epistemic.upper()
    end = post.get("valid_to") or post.get("valid_until")
    if end and days_ago(str(end)) >= 0:
        return f"EXPIRED {end}"
    verified = str(post.get("last_verified_at") or "")
    age = days_ago(verified) if verified else -1
    if age > int(load_config()["stale_days"]):
        return f"STALE {age}d"
    return ""


# Words that carry no topical signal in a corpus that is entirely about one
# company's infrastructure, tooling, and people.
STOPWORDS = set("""a an the and or but if then than that this these those it its is are was were be been
being of to in on at by for with from as into over under about across per via not no nor so such only
just do does did done doing have has had having can could should would will shall may might must
we you they he she i our your their his her them us me my one two also more most other another same
each any all both few many much some very when where which who whom whose what why how while during
before after above below between there here now new newly still yet even ever never always often
sometimes usually routinely rather instead however though although because since until unless whether
either neither thing things way ways use used uses using make makes made get gets got knowledge fact
facts note notes""".split())


def content_tokens(text: str) -> list[str]:
    """Topical tokens, with compounds emitted three ways.

    Service names must survive intact (`aks-prod-weu-01` is one thing),
    but a fact written "per-cluster" has to match a paraphrase written "per
    cluster". So each compound yields the whole token, the punctuation-squashed
    form, and its parts — which also makes `argo-cd` match `argocd`.
    """
    out: list[str] = []
    for raw in re.findall(r"[a-z][a-z0-9_.-]*", (text or "").lower()):
        w = raw.strip(".-")
        if not w:
            continue
        if len(w) > 2 and w not in STOPWORDS:
            out.append(w)
        if any(c in w for c in "-."):
            squashed = re.sub(r"[-.]+", "", w)
            if len(squashed) > 2 and squashed not in STOPWORDS:
                out.append(squashed)
            for part in re.split(r"[-.]+", w):
                if len(part) > 2 and part not in STOPWORDS:
                    out.append(part)
    return out


def _idf(docs: list[list[str]]) -> dict[str, float]:
    n = len(docs) or 1
    df: dict[str, int] = {}
    for d in docs:
        for w in set(d):
            df[w] = df.get(w, 0) + 1
    return {w: math.log((1.0 + n) / (1.0 + c)) + 1.0 for w, c in df.items()}


def _vec(toks: list[str], idf: dict[str, float]) -> dict[str, float]:
    """L2-normalised sublinear-tf x idf vector."""
    tf: dict[str, float] = {}
    for w in toks:
        tf[w] = tf.get(w, 0.0) + 1.0
    v = {w: (1.0 + math.log(c)) * idf.get(w, 1.0) for w, c in tf.items()}
    norm = math.sqrt(sum(x * x for x in v.values())) or 1.0
    return {w: x / norm for w, x in v.items()}


def _cos(a: dict[str, float], b: dict[str, float]) -> float:
    if len(b) < len(a):
        a, b = b, a
    return sum(x * b.get(w, 0.0) for w, x in a.items())


def corpus(include_store: bool = True, include_rejected: bool = True) -> list[tuple[str, str, str, str]]:
    """Everything a new candidate could duplicate: (kind, id, text, detail)."""
    out: list[tuple[str, str, str, str]] = []
    if include_store:
        for fid, post in all_facts():
            if post.get("invalidated_at"):
                continue
            out.append(("fact", fid, post.content, "already in the store"))
    for pid, data in all_pending():
        out.append(("pending", pid, str(data.get("text", "")), "already queued for review"))
    if include_rejected:
        for rid, data in all_rejected():
            reason = data.get("rejection_reason") or "no reason recorded"
            out.append(("rejected", rid, str(data.get("text", "")), f"rejected: {reason}"))
    return out


def score_against_corpus(text: str, entries: list[tuple[str, str, str, str]]) -> list[tuple[float, str, str, str]]:
    """Cosine-score `text` against every corpus entry, best first."""
    docs = [content_tokens(e[2]) for e in entries]
    target = content_tokens(text)
    idf = _idf(docs + [target])
    tv = _vec(target, idf)
    scored = []
    for e, d in zip(entries, docs):
        scored.append((_cos(tv, _vec(d, idf)), e[0], e[1], e[3]))
    scored.sort(key=lambda r: -r[0])
    return scored


# Numbers that appear with a unit. Bare integers and years are too noisy to
# compare, so they never reach the disagreement check.
MAGNITUDE = re.compile(
    r"\b(\d+(?:[.,]\d+)?)\s*"
    r"(kb|mb|gb|k\b|m\b|bytes?|chars?|characters?|tokens?|%|"
    r"days?|hours?|hrs?|minutes?|mins?|weeks?|months?|"
    r"nodes?|clusters?|repos?|people|attendees?|events?)",
    re.I,
)

# Coarse classes, so "50KB", "65k chars" and "25k tokens" are recognised as
# three answers to the same question instead of three unrelated units.
UNIT_CLASS = {
    "kb": "size", "mb": "size", "gb": "size", "k": "size", "m": "size",
    "byte": "size", "bytes": "size", "char": "size", "chars": "size",
    "character": "size", "characters": "size", "token": "size", "tokens": "size",
    "day": "duration", "days": "duration", "hour": "duration", "hours": "duration",
    "hr": "duration", "hrs": "duration", "minute": "duration", "minutes": "duration",
    "min": "duration", "mins": "duration", "week": "duration", "weeks": "duration",
    "month": "duration", "months": "duration",
    "%": "share",
    "node": "count", "nodes": "count", "cluster": "count", "clusters": "count",
    "repo": "count", "repos": "count", "people": "count",
    "attendee": "count", "attendees": "count", "event": "count", "events": "count",
}


def numeric_conflicts(texts: list[str]) -> list[str]:
    """Flag a cluster whose members assert different magnitudes for one thing.

    This is what makes a duplicate batch actionable: fifteen candidates saying
    "results spill to disk" is merely tedious, but three of them naming 25k, 30k
    and 50KB as the same threshold means at least two are wrong.

    A hint for a human reviewer, not an assertion — values are canonicalised so
    "10 char" and "10 chars" stop counting as a disagreement, but two genuinely
    unrelated sizes in one cluster will still show up.
    """
    scale = {"kb": 1e3, "k": 1e3, "mb": 1e6, "gb": 1e9}
    by_class: dict[str, dict[float, str]] = {}
    for t in texts:
        for m in MAGNITUDE.finditer(t):
            raw = re.sub(r"\s+", " ", m.group(0).strip().lower())
            unit = m.group(2).strip().lower().rstrip(".")
            cls = UNIT_CLASS.get(unit)
            if not cls:
                continue
            try:
                val = float(m.group(1).replace(",", ".")) * scale.get(unit, 1.0)
            except ValueError:
                continue
            by_class.setdefault(cls, {}).setdefault(val, raw)
    out = []
    for cls, vals in sorted(by_class.items()):
        if len(vals) > 1:
            shown = [vals[v] for v in sorted(vals)]
            out.append(f"members disagree on {cls}: " + ", ".join(shown))
    return out


def cluster_texts(items: list[tuple[str, str]], threshold: float) -> list[list[int]]:
    """Single-linkage clustering over (id, text) pairs. Returns index groups."""
    docs = [content_tokens(t) for _, t in items]
    idf = _idf(docs)
    vecs = [_vec(d, idf) for d in docs]
    n = len(items)
    parent = list(range(n))

    def find(x: int) -> int:
        while parent[x] != x:
            parent[x] = parent[parent[x]]
            x = parent[x]
        return x

    sims: dict[tuple[int, int], float] = {}
    for i in range(n):
        for j in range(i + 1, n):
            sc = _cos(vecs[i], vecs[j])
            if sc >= threshold and entity_conflict(items[i][1], items[j][1]):
                continue
            if sc >= threshold:
                sims[(i, j)] = sc
                a, b = find(i), find(j)
                if a != b:
                    parent[a] = b
    groups: dict[int, list[int]] = {}
    for i in range(n):
        groups.setdefault(find(i), []).append(i)
    ordered = sorted(groups.values(), key=lambda g: (-len(g), g[0]))
    cluster_texts.last_sims = sims  # type: ignore[attr-defined]
    return ordered


def find_near_duplicate(text: str) -> Optional[tuple[str, str, str]]:
    """Return (kind, id, detail) for the closest duplicate, or None.

    Two gates, either of which fires: the legacy Jaccard overlap and a tf-idf
    cosine that actually catches reworded restatements.
    """
    entries = corpus()
    if not entries:
        return None
    bodies = {(e[0], e[1]): e[2] for e in entries}
    for score, kind, ident, detail in score_against_corpus(text, entries):
        if score < thresh("duplicate_cosine"):
            break
        if entity_conflict(text, bodies.get((kind, ident), "")):
            continue          # same template, different subject: not a duplicate
        return kind, ident, f"{detail}, cosine {score:.2f}"
    best: Optional[tuple[float, str, str, str]] = None
    for kind, ident, body, detail in entries:
        sc = similarity(text, body)
        if sc >= thresh("duplicate_jaccard") and not entity_conflict(text, body) \
                and (best is None or sc > best[0]):
            best = (sc, kind, ident, detail)
    if best is None:
        return None
    _, kind, ident, detail = best
    return kind, ident, detail


def find_related(text: str) -> list[str]:
    """Neighbours too close to ignore but too far to refuse. Recorded as `near:`."""
    entries = corpus(include_rejected=False)
    if not entries:
        return []
    bodies = {(e[0], e[1]): e[2] for e in entries}
    out = []
    for score, kind, ident, _detail in score_against_corpus(text, entries):
        if score < thresh("related_cosine"):
            break
        if score < thresh("duplicate_cosine") and not entity_conflict(text, bodies.get((kind, ident), "")):
            out.append(f"{ident} ({score:.2f})")
    return out[:5]


# -------- helpers --------

def slugify(text: str, max_words: int = 6) -> str:
    words = re.findall(r"[a-z0-9]+", text.lower())[:max_words]
    return "-".join(words) or "fact"


def detect_repo(cwd: str = "") -> str:
    """The GitHub owner/name of the checkout `cwd` sits in, or "" when it sits in
    none. Read from the origin remote rather than the directory name, so a
    worktree, a clone under a different path, or a sandbox fork all report what
    they actually are. Returning "" is a real answer: plenty of facts are
    proposed from a home directory and do not belong to a repo."""
    cwd = cwd or os.getcwd()
    if not os.path.isdir(cwd):
        return ""
    try:
        subprocess.run(["git", "-C", cwd, "rev-parse", "--show-toplevel"],
                       capture_output=True, text=True, check=True, timeout=5)
        url = subprocess.run(["git", "-C", cwd, "remote", "get-url", "origin"],
                             capture_output=True, text=True, timeout=5)
    except (subprocess.CalledProcessError, subprocess.TimeoutExpired, OSError):
        return ""
    if url.returncode != 0:
        return ""
    m = re.search(r"github\.com[:/]+([^/]+)/(.+?)(?:\.git)?/?$", url.stdout.strip())
    return f"{m.group(1)}/{m.group(2)}" if m else ""


def git_context(cwd: str = "") -> dict[str, str]:
    """Canonical repository and revision context for a checkout, best-effort."""
    cwd = cwd or os.getcwd()
    if not os.path.isdir(cwd):
        return {"repo": "", "root": "", "revision": "", "branch": ""}

    def run(*args: str) -> str:
        try:
            result = subprocess.run(
                ["git", "-C", cwd, *args], capture_output=True, text=True,
                timeout=5, check=False,
            )
        except (subprocess.TimeoutExpired, OSError):
            return ""
        return result.stdout.strip() if result.returncode == 0 else ""

    return {
        "repo": detect_repo(cwd),
        "root": run("rev-parse", "--show-toplevel"),
        "revision": run("rev-parse", "HEAD"),
        "branch": run("branch", "--show-current"),
    }


def repo_checkout(repo: str, cwd: str = "") -> Optional[Path]:
    """Resolve a canonical owner/name to a local checkout without writing to it."""
    if not repo:
        return None
    here = git_context(cwd)
    if here["repo"].lower() == repo.lower() and here["root"]:
        return Path(here["root"])

    parts = repo.split("/", 1)
    candidates: list[Path] = []
    for raw in load_config().get("repo_roots") or []:
        root = Path(str(raw)).expanduser()
        if len(parts) == 2:
            candidates.extend([root / parts[0] / parts[1], root / parts[1]])
    for candidate in candidates:
        if candidate.is_dir() and detect_repo(str(candidate)).lower() == repo.lower():
            return candidate
    return None


def commit_applies(post: frontmatter.Post, checkout: Optional[Path]) -> bool:
    """Whether HEAD lies in a claim's half-open commit interval.

    Unknown ancestry is not disproof, so an unavailable checkout keeps the
    assertion eligible and lets freshness/status communicate the uncertainty.
    """
    start = str(post.get("valid_from_commit") or "")
    end = str(post.get("valid_to_commit") or "")
    if not checkout or not (start or end):
        return True

    def ancestor(older: str, newer: str = "HEAD") -> Optional[bool]:
        try:
            result = subprocess.run(
                ["git", "-C", str(checkout), "merge-base", "--is-ancestor", older, newer],
                capture_output=True, timeout=10, check=False,
            )
        except (subprocess.TimeoutExpired, OSError):
            return None
        if result.returncode == 0:
            return True
        if result.returncode == 1:
            return False
        return None

    if start and ancestor(start) is False:
        return False
    if end and ancestor(end) is True:
        return False
    return True


def today_iso() -> str:
    return date.today().isoformat()


def days_ago(iso: str) -> int:
    try:
        d = date.fromisoformat(iso)
    except (TypeError, ValueError):
        return -1
    return (date.today() - d).days


def iso_date(value: str, label: str) -> str:
    if not value:
        return ""
    try:
        return date.fromisoformat(value[:10]).isoformat()
    except ValueError:
        raise typer.BadParameter(f"{label} must be an ISO date (YYYY-MM-DD): {value}")


def valid_at(post: frontmatter.Post, as_of: str = "") -> bool:
    """Whether a claim applies at a point in valid (world) time."""
    point = date.fromisoformat(iso_date(as_of, "--as-of") or today_iso())
    start = str(post.get("valid_from") or "")
    end = str(post.get("valid_to") or post.get("valid_until") or "")
    if start and point < date.fromisoformat(start[:10]):
        return False
    if end and point >= date.fromisoformat(end[:10]):
        return False
    return True


def assertion_retrievable(post: frontmatter.Post, as_of: str = "") -> bool:
    if post.get("invalidated_at"):
        return False
    if str(post.get("epistemic_status") or "supported") in {"refuted", "superseded"}:
        return False
    return valid_at(post, as_of)


def default_scope() -> str:
    """First configured literal scope. What `--scope` falls back to."""
    lits = [str(x) for x in load_config().get("scopes") or []]
    return lits[0] if lits else "personal"


def validate_scope(scope: str) -> None:
    cfg = load_config()
    literal = [str(x) for x in cfg.get("scopes") or []]
    prefixed = [str(x) for x in cfg.get("prefixed_scopes") or []]
    if scope in literal:
        return
    for pfx in prefixed:
        if scope.startswith(f"{pfx}:") and len(scope) > len(pfx) + 1:
            return
    allowed = ", ".join([*literal, *[f"{p}:<value>" for p in prefixed]]) or "(none configured)"
    raise typer.BadParameter(f"Invalid scope '{scope}'. Configured scopes: {allowed}")


def validate_confidence(c: str) -> None:
    if c not in CONFIDENCE_VALUES:
        raise typer.BadParameter(f"confidence must be one of {sorted(CONFIDENCE_VALUES)}")


def validate_provenance(p: str) -> None:
    if p not in PROVENANCE_VALUES:
        raise typer.BadParameter(f"provenance must be one of {sorted(PROVENANCE_VALUES)}")


def validate_epistemic_status(status: str) -> None:
    if status not in EPISTEMIC_STATUS_VALUES:
        raise typer.BadParameter(
            f"epistemic status must be one of {sorted(EPISTEMIC_STATUS_VALUES)}"
        )


def validator_spec(kind: str, path: str = "", expected: str = "") -> Optional[dict]:
    if not kind:
        return None
    if kind not in {"git-path", "git-file-contains"}:
        raise typer.BadParameter("--validator must be git-path or git-file-contains")
    if not path:
        raise typer.BadParameter(f"--repo-path is required for --validator {kind}")
    if kind == "git-file-contains" and not expected:
        raise typer.BadParameter("--expected is required for --validator git-file-contains")
    spec = {"type": kind, "path": path}
    if expected:
        spec["expected"] = expected
    return spec


def derive_id(topic_slug: str, text: str, override: Optional[str] = None) -> str:
    topic_words = set(topic_slug.split("-"))
    body_words = [w for w in re.findall(r"[a-z0-9]+", text.lower()) if w not in topic_words]
    body_slug = "-".join(body_words[:5]) or "fact"
    fid = override or f"{topic_slug}-{body_slug}"
    if not re.fullmatch(r"[a-z0-9-]+", fid):
        raise typer.BadParameter(f"--id must be kebab-case: got '{fid}'")
    return fid


def write_new_fact(
    fid: str,
    text: str,
    topic_slug: str,
    scope: str,
    confidence: str,
    source: str,
    valid_until: Optional[str] = None,
    provenance: Optional[str] = None,
    repo: str = "",
    evidence: str = "",
    subject: str = "",
    predicate: str = "",
    object_value: str = "",
    valid_from: str = "",
    valid_to: str = "",
    valid_from_commit: str = "",
    valid_to_commit: str = "",
    repo_revision: str = "",
    repo_path: str = "",
    episodes: Optional[list[str]] = None,
    validator: Optional[dict] = None,
    epistemic_status: str = "supported",
) -> Path:
    today = today_iso()
    meta = {
        "id": fid,
        "topic": topic_slug,
        "scope": scope,
        "learned_at": today,
        "last_verified_at": today,
        "valid_until": valid_until,
        "invalidated_at": None,
        "invalidation_reason": None,
        "confidence": confidence,
        "source": source or f"session-{today}",
        "recorded_at": utc_now_iso(),
        "epistemic_status": epistemic_status,
    }
    if provenance:
        meta["provenance"] = provenance
    if repo:
        meta["repo"] = repo
    # Without this the quote or file:line that justified the fact dies at
    # promotion, leaving `source: session-<date>` as the only pointer — which
    # cannot be re-checked without redoing the original research.
    if evidence:
        meta["evidence"] = evidence
    for key, value in (
        ("subject", subject), ("predicate", predicate), ("object", object_value),
        ("valid_from", valid_from), ("valid_to", valid_to),
        ("valid_from_commit", valid_from_commit), ("valid_to_commit", valid_to_commit),
        ("repo_revision", repo_revision), ("repo_path", repo_path),
    ):
        if value:
            meta[key] = value
    if episodes:
        meta["episodes"] = episodes
    if validator:
        meta["validator"] = validator
    save_fact(fid, frontmatter.Post(text, **meta))
    append_event("assertion.stored", fid, status=epistemic_status, repo=repo)
    return fact_path(fid)


# -------- graph projection --------

def _entity_parts(ident: str) -> tuple[str, str]:
    kind, sep, label = ident.partition(":")
    return (kind, label) if sep else ("entity", ident)


def graph_fingerprint() -> str:
    """Cheap change detector for rebuilding the disposable graph projection."""
    paths = [p for p in knowledge_dir().glob("*.md")]
    paths += [p for p in pending_dir().glob("*.yml")] if pending_dir().exists() else []
    paths += [p for p in episodes_dir().rglob("*.yml")] if episodes_dir().exists() else []
    for name in (VALIDATION_LOG_NAME,):
        p = knowledge_dir() / name
        if p.exists():
            paths.append(p)
    material = []
    for p in sorted(paths):
        try:
            st = p.stat()
        except OSError:
            continue
        material.append(f"{p.relative_to(knowledge_dir())}:{st.st_size}:{st.st_mtime_ns}")
    return hashlib.sha256("\n".join(material).encode()).hexdigest()


def rebuild_graph() -> dict[str, int]:
    """Rebuild the external SQLite projection from files and append-only logs."""
    path = graph_index_path()
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_suffix(".tmp.sqlite3")
    if tmp.exists():
        tmp.unlink()
    conn = sqlite3.connect(tmp)
    try:
        conn.executescript("""
        PRAGMA journal_mode = OFF;
        PRAGMA synchronous = OFF;
        CREATE TABLE metadata (key TEXT PRIMARY KEY, value TEXT NOT NULL);
        CREATE TABLE entities (
          id TEXT PRIMARY KEY, kind TEXT NOT NULL, label TEXT NOT NULL
        );
        CREATE TABLE assertions (
          id TEXT PRIMARY KEY, text TEXT NOT NULL, topic TEXT, scope TEXT,
          confidence TEXT, provenance TEXT, epistemic_status TEXT NOT NULL,
          trusted INTEGER NOT NULL, repo TEXT, revision TEXT, path TEXT,
          subject TEXT, predicate TEXT, object TEXT,
          valid_from TEXT, valid_to TEXT, recorded_at TEXT,
          last_verified_at TEXT, invalidated_at TEXT, validator_json TEXT
        );
        CREATE TABLE edges (
          assertion_id TEXT PRIMARY KEY, subject TEXT NOT NULL,
          predicate TEXT NOT NULL, object TEXT NOT NULL,
          FOREIGN KEY(assertion_id) REFERENCES assertions(id)
        );
        CREATE INDEX edges_subject ON edges(subject);
        CREATE INDEX edges_object ON edges(object);
        CREATE TABLE episodes (
          id TEXT PRIMARY KEY, kind TEXT, text TEXT NOT NULL, source TEXT,
          observed_at TEXT, reference_time TEXT, repo TEXT, revision TEXT,
          branch TEXT, path TEXT
        );
        CREATE TABLE assertion_episodes (
          assertion_id TEXT NOT NULL, episode_id TEXT NOT NULL,
          PRIMARY KEY(assertion_id, episode_id)
        );
        CREATE TABLE validations (
          seq INTEGER PRIMARY KEY AUTOINCREMENT, assertion_id TEXT NOT NULL,
          outcome TEXT NOT NULL, observed_at TEXT NOT NULL,
          validator TEXT, evidence TEXT, detail TEXT
        );
        """)

        def add_assertion(ident: str, text: str, data, trusted: int) -> None:
            status = str(data.get("epistemic_status") or ("supported" if trusted else "unknown"))
            conn.execute(
                """INSERT INTO assertions VALUES (?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?)""",
                (
                    ident, text, str(data.get("topic") or ""), str(data.get("scope") or ""),
                    str(data.get("confidence") or ""), str(data.get("provenance") or ""),
                    status, trusted, str(data.get("repo") or ""),
                    str(data.get("repo_revision") or ""), str(data.get("repo_path") or ""),
                    str(data.get("subject") or ""), str(data.get("predicate") or ""),
                    str(data.get("object") or ""), str(data.get("valid_from") or ""),
                    str(data.get("valid_to") or data.get("valid_until") or ""),
                    str(data.get("recorded_at") or data.get("proposed_at") or ""),
                    str(data.get("last_verified_at") or ""), str(data.get("invalidated_at") or ""),
                    json.dumps(data.get("validator") or {}, sort_keys=True),
                ),
            )
            subject = str(data.get("subject") or "")
            predicate = str(data.get("predicate") or "")
            object_value = str(data.get("object") or "")
            if subject and predicate and object_value:
                for entity in (subject, object_value):
                    kind, label = _entity_parts(entity)
                    conn.execute("INSERT OR IGNORE INTO entities VALUES (?,?,?)", (entity, kind, label))
                conn.execute("INSERT INTO edges VALUES (?,?,?,?)", (ident, subject, predicate, object_value))
            for episode_id in data.get("episodes") or []:
                conn.execute(
                    "INSERT OR IGNORE INTO assertion_episodes VALUES (?,?)",
                    (ident, str(episode_id)),
                )

        for fid, post in all_facts():
            add_assertion(fid, " ".join(post.content.split()), post, 1)
        for pid, data in all_pending():
            add_assertion(pid, " ".join(str(data.get("text") or "").split()), data, 0)
        for eid, data in all_episodes():
            conn.execute(
                "INSERT INTO episodes VALUES (?,?,?,?,?,?,?,?,?,?)",
                (
                    eid, str(data.get("kind") or ""), str(data.get("text") or ""),
                    str(data.get("source") or ""), str(data.get("observed_at") or ""),
                    str(data.get("reference_time") or ""), str(data.get("repo") or ""),
                    str(data.get("revision") or ""), str(data.get("branch") or ""),
                    str(data.get("path") or ""),
                ),
            )
        for row in read_jsonl(VALIDATION_LOG_NAME):
            conn.execute(
                """INSERT INTO validations
                   (assertion_id,outcome,observed_at,validator,evidence,detail)
                   VALUES (?,?,?,?,?,?)""",
                (
                    str(row.get("assertion_id") or ""), str(row.get("outcome") or "unknown"),
                    str(row.get("observed_at") or ""), str(row.get("validator") or ""),
                    str(row.get("evidence") or ""), str(row.get("detail") or ""),
                ),
            )
        counts = {
            "assertions": conn.execute("SELECT count(*) FROM assertions").fetchone()[0],
            "entities": conn.execute("SELECT count(*) FROM entities").fetchone()[0],
            "edges": conn.execute("SELECT count(*) FROM edges").fetchone()[0],
            "episodes": conn.execute("SELECT count(*) FROM episodes").fetchone()[0],
            "validations": conn.execute("SELECT count(*) FROM validations").fetchone()[0],
        }
        conn.execute("INSERT INTO metadata VALUES (?,?)", ("fingerprint", graph_fingerprint()))
        conn.execute("INSERT INTO metadata VALUES (?,?)", ("built_at", utc_now_iso()))
        conn.commit()
    finally:
        conn.close()
    os.replace(tmp, path)
    return counts


def ensure_graph() -> Path:
    path = graph_index_path()
    current = graph_fingerprint()
    if path.exists():
        try:
            conn = sqlite3.connect(path)
            row = conn.execute("SELECT value FROM metadata WHERE key='fingerprint'").fetchone()
            conn.close()
            if row and row[0] == current:
                return path
        except sqlite3.Error:
            pass
    rebuild_graph()
    return path


# -------- deterministic validation --------

def run_validator(post: frontmatter.Post) -> tuple[str, str, str]:
    """Return outcome, evidence, detail. Never infer contradiction from outage."""
    spec = post.get("validator")
    if not isinstance(spec, dict) or not spec.get("type"):
        return "unknown", "", "no validator configured"
    kind = str(spec["type"])
    repo = str(post.get("repo") or "")
    checkout = repo_checkout(repo)
    if not checkout:
        return "unknown", repo, "repository checkout unavailable"
    if not all(str(post.get(x) or "") for x in ("subject", "predicate", "object")):
        return "unknown", repo, "typed subject/predicate/object required for automatic validation"
    path = str(spec.get("path") or post.get("repo_path") or "")
    if not path:
        return "unknown", repo, "validator has no repository path"

    revision = "HEAD"
    try:
        show = subprocess.run(
            ["git", "-C", str(checkout), "show", f"{revision}:{path}"],
            capture_output=True, text=True, timeout=15, check=False,
        )
    except subprocess.TimeoutExpired:
        return "unknown", f"{repo}@{revision}:{path}", "repository validation timed out"
    except OSError as exc:
        return "unknown", f"{repo}@{revision}:{path}", f"repository validation unavailable: {exc}"
    evidence = f"{repo}@{git_context(str(checkout))['revision']}:{path}"
    if kind == "git-path":
        if str(post.get("predicate")) not in {"contains_path", "has_path"}:
            return "unknown", evidence, "git-path only validates contains_path/has_path assertions"
        return (
            ("supported", evidence, "path exists") if show.returncode == 0
            else ("contradicted", evidence, "path does not exist at HEAD")
        )
    if kind == "git-file-contains":
        if show.returncode != 0:
            return "contradicted", evidence, "evidence path does not exist at HEAD"
        expected = str(spec.get("expected") or "")
        if expected in show.stdout:
            return "supported", evidence, "expected literal is present"
        return "contradicted", evidence, "expected literal is absent"
    return "unknown", evidence, f"unsupported validator: {kind}"


def record_validation(
    fact_id: str,
    post: frontmatter.Post,
    outcome: str,
    evidence: str,
    detail: str,
    *,
    mutate: bool = True,
) -> None:
    if outcome not in VALIDATION_OUTCOMES:
        raise ValueError(outcome)
    observed_at = utc_now_iso()
    spec = post.get("validator") if isinstance(post.get("validator"), dict) else {}
    row = {
        "assertion_id": fact_id,
        "outcome": outcome,
        "observed_at": observed_at,
        "validator": str(spec.get("type") or "none"),
        "evidence": evidence,
        "detail": detail,
    }
    if not mutate:
        return
    append_jsonl(VALIDATION_LOG_NAME, row)
    if outcome == "supported":
        post["epistemic_status"] = "supported"
        post["last_verified_at"] = observed_at[:10]
        post.metadata.pop("refuted_at", None)
        post.metadata.pop("refutation_reason", None)
    elif outcome == "contradicted":
        post["epistemic_status"] = "refuted"
        post["refuted_at"] = observed_at
        post["refutation_reason"] = detail
    elif outcome == "unknown":
        post["epistemic_status"] = "unknown"
    save_fact(fact_id, post)
    append_event("assertion.validated", fact_id, outcome=outcome, evidence=evidence)


# -------- qmd duplicate check --------

QMD_HIT_RE = re.compile(
    r"qmd://(?P<path>[^:\s]+):(?P<line>\d+).*?Score:\s+(?P<score>\d+)%",
    re.DOTALL,
)


def qmd_similar(text: str, limit: int = 5) -> list[tuple[str, int]]:
    """Return [(path, score)] for hits in the knowledge/ folder. Best-effort."""
    try:
        result = subprocess.run(
            ["qmd", "query", text],
            capture_output=True,
            text=True,
            timeout=60,
        )
    except FileNotFoundError:
        err_console.print("[yellow]qmd not found on PATH; skipping duplicate check[/yellow]")
        return []
    except subprocess.TimeoutExpired:
        err_console.print("[yellow]qmd query timed out; skipping duplicate check[/yellow]")
        return []

    hits = []
    # only accept hits from inside the store; the indexer covers a whole vault
    needle = knowledge_dir().name + "/"
    for m in QMD_HIT_RE.finditer(result.stdout):
        path = m.group("path")
        if needle in path:
            hits.append((path, int(m.group("score"))))
        if len(hits) >= limit:
            break
    return hits


# -------- commands --------

@app.command("add")
def cmd_add(
    text: str = typer.Argument(..., help="The fact, one sentence."),
    topic: str = typer.Option(..., "--topic", "-t", help="Topic prefix (e.g. 'argocd')."),
    scope: Optional[str] = typer.Option(None, "--scope", "-s"),
    confidence: str = typer.Option("medium", "--confidence", "-c"),
    source: str = typer.Option("", "--source"),
    evidence: str = typer.Option("", "--evidence", "-e", help="Quote, URL, or file:line a future reader can re-check."),
    valid_until: Optional[str] = typer.Option(None, "--valid-until", help="ISO date or empty."),
    subject: str = typer.Option("", "--subject", help="Canonical entity id, e.g. repo:acme/widgets."),
    predicate: str = typer.Option("", "--predicate", help="Typed relation, e.g. owned_by."),
    object_value: str = typer.Option("", "--object", help="Canonical entity id or literal value."),
    valid_from: str = typer.Option("", "--valid-from", help="World-validity start date."),
    valid_to: str = typer.Option("", "--valid-to", help="Exclusive world-validity end date."),
    repo: Optional[str] = typer.Option(None, "--repo", help="Repository this assertion is about."),
    repo_revision: str = typer.Option("", "--repo-revision", help="Evidence commit SHA."),
    repo_path: str = typer.Option("", "--repo-path", help="Evidence path within the repository."),
    validator: str = typer.Option("", "--validator", help="git-path | git-file-contains"),
    expected: str = typer.Option("", "--expected", help="Literal required by git-file-contains."),
    fact_id: Optional[str] = typer.Option(None, "--id", help="Override auto-slugged ID."),
    yes: bool = typer.Option(False, "--yes", "-y", help="Skip duplicate-check prompt."),
):
    """Add a new fact. Runs qmd similarity check and prompts before writing."""
    scope = scope or default_scope()
    validate_scope(scope)
    validate_confidence(confidence)
    valid_from = iso_date(valid_from, "--valid-from")
    valid_to = iso_date(valid_to, "--valid-to")
    spec = validator_spec(validator, repo_path, expected)
    ctx = git_context()
    final_repo = repo if repo is not None else ctx["repo"]
    repo_revision = repo_revision or (ctx["revision"] if final_repo == ctx["repo"] else "")

    topic_slug = slugify(topic, max_words=3)
    fid = derive_id(topic_slug, text, fact_id)

    if fact_path(fid).exists():
        err_console.print(f"[red]Already exists:[/red] {fid}.md")
        raise typer.Exit(2)

    if not yes:
        same_topic = [
            (fid_, post_)
            for fid_, post_ in all_facts()
            if post_.get("topic") == topic_slug and not post_.get("invalidated_at")
        ]
        if same_topic:
            console.print(f"\n[bold]Existing facts with topic '{topic_slug}':[/bold]")
            for fid_, post_ in same_topic:
                body_preview = (post_.content[:80] + "…") if len(post_.content) > 80 else post_.content
                console.print(f"  • [cyan]{fid_}[/cyan] — {body_preview}")

        console.print(f"\n[dim]Checking qmd for semantically similar facts…[/dim]")
        hits = qmd_similar(text)
        if hits:
            console.print("\n[bold]Similar existing notes in knowledge/:[/bold]")
            for i, (path, score) in enumerate(hits, 1):
                console.print(f"  {i}. {Path(path).name}  [dim](sim {score}%)[/dim]")
        elif not same_topic:
            console.print("[dim]No similar facts found.[/dim]")

        if same_topic or hits:
            choice = Prompt.ask(
                "\n[c]onfirm new  [a]bort", choices=["c", "a"], default="c"
            )
            if choice == "a":
                console.print("[yellow]Aborted.[/yellow]")
                raise typer.Exit(1)

    path = write_new_fact(
        fid, text, topic_slug, scope, confidence, source, valid_until,
        repo=final_repo, evidence=evidence, subject=subject, predicate=predicate,
        object_value=object_value, valid_from=valid_from, valid_to=valid_to,
        repo_revision=repo_revision, repo_path=repo_path, validator=spec,
    )
    console.print(f"[green]Wrote[/green] {path}")


# -------- episode ingestion --------

@app.command("ingest")
def cmd_ingest(
    text: str = typer.Argument(..., help="Raw observation, message, or source text."),
    kind: str = typer.Option("text", "--kind", help="message | text | json | observation"),
    source: str = typer.Option("", "--source", help="Where this episode came from."),
    reference_time: str = typer.Option("", "--reference-time", help="When it occurred, ISO timestamp/date."),
    repo: Optional[str] = typer.Option(None, "--repo", help="Repository this episode concerns; defaults to cwd origin."),
    revision: str = typer.Option("", "--revision", help="Evidence commit; defaults to cwd HEAD."),
    branch: str = typer.Option("", "--branch", help="Evidence branch; defaults to cwd branch."),
    path: str = typer.Option("", "--path", help="Optional repository-relative evidence path."),
    quiet: bool = typer.Option(False, "--quiet", help="Print only the episode id."),
):
    """Append untrusted source material without dedupe, review, or a rate limit."""
    if not text.strip():
        raise typer.BadParameter("episode text must not be empty")
    if kind not in {"message", "text", "json", "observation"}:
        raise typer.BadParameter("--kind must be message, text, json, or observation")
    ctx = git_context()
    final_repo = repo if repo is not None else ctx["repo"]
    if final_repo != ctx["repo"]:
        revision = revision or ""
        branch = branch or ""
    else:
        revision = revision or ctx["revision"]
        branch = branch or ctx["branch"]
    eid, dest = write_episode(
        text.strip(), kind=kind, source=source, reference_time=reference_time,
        repo=final_repo, revision=revision, branch=branch, path=path,
    )
    if quiet:
        sys.stdout.write(f"{eid}\n")
    else:
        console.print(f"[green]Ingested[/green] {eid} → {dest}")


@app.command("episodes")
def cmd_episodes(
    repo: Optional[str] = typer.Option(None, "--repo", help="Filter by canonical owner/name."),
    limit: int = typer.Option(20, "--limit", "-n"),
    as_json: bool = typer.Option(False, "--json"),
):
    """List recent untrusted episodes. They are evidence, never citable facts."""
    rows = [(eid, data) for eid, data in all_episodes()
            if repo is None or str(data.get("repo") or "") == repo]
    rows.sort(key=lambda row: str(row[1].get("observed_at") or ""), reverse=True)
    rows = rows[:limit]
    if as_json:
        sys.stdout.write(json.dumps([data for _, data in rows], indent=2) + "\n")
        return
    for eid, data in rows:
        preview = " ".join(str(data.get("text") or "").split())[:120]
        console.print(
            f"[bold]{eid}[/bold] [dim]{data.get('observed_at', '')} "
            f"{data.get('repo', '')}@{str(data.get('revision', ''))[:10]}[/dim]\n"
            f"      {preview}"
        )
    console.print(f"[dim]{len(rows)} untrusted episode(s)[/dim]")


@app.command("migrate")
def cmd_migrate(
    pending: bool = typer.Option(True, "--pending/--no-pending", help="Also migrate current candidate assertions."),
    dry_run: bool = typer.Option(False, "--dry-run", help="Report changes without writing them."),
    rebuild: bool = typer.Option(True, "--rebuild-graph/--no-rebuild-graph", help="Rebuild the external graph after migration."),
    as_json: bool = typer.Option(False, "--json"),
):
    """Backfill legacy assertions into the temporal evidence model.

    This is deliberately structural: it creates source episodes, recorded time,
    and epistemic defaults, but never guesses typed subject/predicate/object
    relationships from prose. It is safe to run repeatedly.
    """
    counts = migrate_legacy_store(include_pending=pending, dry_run=dry_run)
    graph_counts: dict[str, int] = {}
    if rebuild and not dry_run:
        graph_counts = rebuild_graph()
    result = {**counts, "dry_run": dry_run, "graph": graph_counts}
    if as_json:
        sys.stdout.write(json.dumps(result, indent=2) + "\n")
        return
    mode = "Would migrate" if dry_run else "Migrated"
    console.print(
        f"[green]{mode}[/green] facts={counts['facts_changed']} "
        f"pending={counts['pending_changed']} episodes={counts['episodes_created']} "
        f"repaired={counts['episodes_updated']}"
    )
    if graph_counts:
        console.print("[dim]Graph rebuilt: " + "  ".join(
            f"{key}={value}" for key, value in graph_counts.items()) + "[/dim]")


@app.command("graph-rebuild")
def cmd_graph_rebuild(as_json: bool = typer.Option(False, "--json")):
    """Rebuild the external SQLite graph projection from the source store."""
    counts = rebuild_graph()
    if as_json:
        sys.stdout.write(json.dumps({"path": str(graph_index_path()), **counts}, indent=2) + "\n")
        return
    console.print(f"[green]Rebuilt[/green] {graph_index_path()}")
    console.print("  " + "  ".join(f"{key}={value}" for key, value in counts.items()))


@app.command("graph-neighbors")
def cmd_graph_neighbors(
    entity: str = typer.Argument(..., help="Canonical entity id, e.g. repo:acme/widgets."),
    depth: int = typer.Option(1, "--depth", min=1, max=3),
    pending: bool = typer.Option(False, "--pending", help="Include untrusted candidate assertions."),
    as_of: str = typer.Option("", "--as-of", help="Valid-time date, YYYY-MM-DD."),
    as_json: bool = typer.Option(False, "--json"),
):
    """Traverse typed assertions around an entity, up to three hops."""
    if as_of:
        as_of = iso_date(as_of, "--as-of")
    path = ensure_graph()
    conn = sqlite3.connect(path)
    conn.row_factory = sqlite3.Row
    try:
        frontier = {entity}
        seen_entities = {entity}
        seen_assertions: set[str] = set()
        results: list[dict] = []
        for hop in range(1, depth + 1):
            if not frontier:
                break
            marks = ",".join("?" for _ in frontier)
            rows = conn.execute(
                f"""SELECT a.*, e.subject, e.predicate, e.object
                    FROM edges e JOIN assertions a ON a.id=e.assertion_id
                    WHERE (e.subject IN ({marks}) OR e.object IN ({marks}))
                      AND (? OR a.trusted=1)""",
                (*frontier, *frontier, int(pending)),
            ).fetchall()
            next_frontier: set[str] = set()
            for row in rows:
                if row["id"] in seen_assertions:
                    continue
                point = as_of or today_iso()
                if row["valid_from"] and point < str(row["valid_from"])[:10]:
                    continue
                if row["valid_to"] and point >= str(row["valid_to"])[:10]:
                    continue
                if row["epistemic_status"] in {"refuted", "superseded"}:
                    continue
                if row["invalidated_at"]:
                    continue
                seen_assertions.add(row["id"])
                item = dict(row)
                item["hop"] = hop
                results.append(item)
                for candidate in (row["subject"], row["object"]):
                    if candidate not in seen_entities:
                        seen_entities.add(candidate)
                        next_frontier.add(candidate)
            frontier = next_frontier
    finally:
        conn.close()
    if as_json:
        sys.stdout.write(json.dumps(results, indent=2) + "\n")
        return
    if not results:
        console.print(f"[dim]No typed assertions connect to {entity}.[/dim]")
        return
    for row in results:
        trust = "" if row["trusted"] else " [yellow](unvetted)[/yellow]"
        console.print(
            f"[dim]hop {row['hop']}[/dim] [bold]{row['subject']}[/bold] "
            f"—{row['predicate']}→ [bold]{row['object']}[/bold]{trust}\n"
            f"      {row['id']}: {row['text'][:160]}"
        )


@app.command("sweep")
def cmd_sweep(
    fact_id: Optional[str] = typer.Argument(None, help="One assertion id; default is every configured validator."),
    repo: Optional[str] = typer.Option(None, "--repo", help="Only assertions about this repository."),
    stale_only: bool = typer.Option(False, "--stale-only", help="Only assertions past stale_days."),
    limit: int = typer.Option(100, "--limit", "-n"),
    dry_run: bool = typer.Option(False, "--dry-run"),
    as_json: bool = typer.Option(False, "--json"),
):
    """Revalidate deterministic assertions and retain support/refutation history."""
    selected: list[tuple[str, frontmatter.Post]] = []
    for fid, post in all_facts():
        if fact_id and fid != fact_id:
            continue
        if repo is not None and str(post.get("repo") or "") != repo:
            continue
        if not isinstance(post.get("validator"), dict):
            continue
        if stale_only:
            verified = str(post.get("last_verified_at") or "")
            if verified and days_ago(verified) < int(load_config()["stale_days"]):
                continue
        selected.append((fid, post))
        if len(selected) >= limit:
            break
    if fact_id and not selected:
        err_console.print(f"[red]No validator-backed assertion:[/red] {fact_id}")
        raise typer.Exit(2)

    results = []
    for fid, post in selected:
        outcome, evidence, detail = run_validator(post)
        record_validation(fid, post, outcome, evidence, detail, mutate=not dry_run)
        results.append({"id": fid, "outcome": outcome, "evidence": evidence, "detail": detail})
    if as_json:
        sys.stdout.write(json.dumps(results, indent=2) + "\n")
        return
    for row in results:
        colour = "green" if row["outcome"] == "supported" else "red" if row["outcome"] == "contradicted" else "yellow"
        console.print(
            f"[{colour}]{row['outcome']}[/{colour}] [bold]{row['id']}[/bold] — {row['detail']}"
            + (f" [dim]({row['evidence']})[/dim]" if row["evidence"] else "")
        )
    console.print(f"[dim]{len(results)} assertion(s) {'would be ' if dry_run else ''}swept[/dim]")


# -------- propose / review commands --------

@app.command("propose")
def cmd_propose(
    text: str = typer.Argument(..., help="The candidate fact, one sentence."),
    topic: str = typer.Option(..., "--topic", "-t", help="Topic prefix (e.g. 'argocd')."),
    scope: Optional[str] = typer.Option(None, "--scope", "-s"),
    confidence: Optional[str] = typer.Option(None, "--confidence", "-c", help="Defaults: high for user-stated, low for inferred."),
    provenance: str = typer.Option("user-stated", "--provenance", "-p", help="user-stated | inferred"),
    evidence: str = typer.Option("", "--evidence", "-e", help="Quote if user-stated; what it was inferred from if inferred."),
    source: str = typer.Option("", "--source"),
    repo: Optional[str] = typer.Option(None, "--repo", help="owner/name this fact is ABOUT. Defaults to the repo cwd sits in; pass it when the two differ."),
    subject: str = typer.Option("", "--subject", help="Canonical entity id, e.g. service:payments."),
    predicate: str = typer.Option("", "--predicate", help="Typed relation, e.g. owned_by."),
    object_value: str = typer.Option("", "--object", help="Canonical entity id or literal value."),
    valid_from: str = typer.Option("", "--valid-from", help="World-validity start date."),
    valid_to: str = typer.Option("", "--valid-to", help="Exclusive world-validity end date."),
    valid_from_commit: str = typer.Option("", "--valid-from-commit", help="First applicable commit."),
    valid_to_commit: str = typer.Option("", "--valid-to-commit", help="First no-longer-applicable commit."),
    repo_revision: str = typer.Option("", "--repo-revision", help="Evidence commit; defaults to cwd HEAD."),
    repo_path: str = typer.Option("", "--repo-path", help="Evidence path within the repository."),
    validator: str = typer.Option("", "--validator", help="git-path | git-file-contains"),
    expected: str = typer.Option("", "--expected", help="Literal required by git-file-contains."),
    episodes: Optional[list[str]] = typer.Option(None, "--episode", help="Source episode id; repeatable."),
    fact_id: Optional[str] = typer.Option(None, "--id", help="Override auto-slugged ID."),
    merges: Optional[str] = typer.Option(None, "--merges",
        help="Comma-separated fact ids this candidate consolidates. Exempts them from the "
             "duplicate gate (a merge is similar to its sources by construction) and records "
             "them so `confirm` can retire them."),
):
    """Queue a candidate fact for later human review. Never writes to the store."""
    scope = scope or default_scope()
    validate_scope(scope)
    validate_provenance(provenance)
    if confidence is None:
        confidence = "low" if provenance == "inferred" else "high"
    validate_confidence(confidence)
    valid_from = iso_date(valid_from, "--valid-from")
    valid_to = iso_date(valid_to, "--valid-to")
    spec = validator_spec(validator, repo_path, expected)

    ctx = git_context()
    final_repo = (repo if repo is not None else ctx["repo"]) or ""
    repo_revision = repo_revision or (ctx["revision"] if final_repo == ctx["repo"] else "")
    episode_ids = list(episodes or [])
    known_episodes = {eid for eid, _ in all_episodes()} if episode_ids else set()
    missing = [eid for eid in episode_ids if eid not in known_episodes]
    if missing:
        raise typer.BadParameter(f"unknown --episode id(s): {', '.join(missing)}")
    if not episode_ids:
        eid, _ = write_episode(
            evidence.strip() or text.strip(), kind="observation", source=source,
            repo=final_repo, revision=repo_revision,
            branch=ctx["branch"] if final_repo == ctx["repo"] else "",
            path=repo_path,
        )
        episode_ids.append(eid)

    topic_slug = slugify(topic, max_words=3)
    pid = derive_id(topic_slug, text, fact_id)

    merge_ids = [x.strip() for x in (merges or "").split(",") if x.strip()]
    for mid in merge_ids:
        if not fact_path(mid).exists():
            err_console.print(f"[red]No such fact to merge:[/red] {mid}")
            raise typer.Exit(2)

    dupe = find_near_duplicate(text)
    if dupe and dupe[1] in merge_ids:
        dupe = None          # a consolidation resembles what it consolidates
    if dupe:
        kind, ident, detail = dupe
        console.print(f"[yellow]Skipped[/yellow] — near-duplicate of {kind} '{ident}' ({detail}).")
        raise typer.Exit(0)
    if (pending_dir() / f"{pid}.yml").exists():
        console.print(f"[yellow]Skipped[/yellow] — '{pid}' is already queued.")
        raise typer.Exit(0)

    today = today_iso()
    record = {
        "id": pid,
        "text": text,
        "topic": topic_slug,
        "scope": scope,
        "confidence": confidence,
        "provenance": provenance,
        "evidence": evidence,
        "source": source or f"session-{today}",
        "proposed_at": today,
        # The repo the fact is ABOUT, which is not always the one you're standing
        # in — a fact about a repo can be learned from anywhere. cwd stays for
        # audit, but grouping reads `repo`.
        "repo": final_repo,
        "cwd": os.getcwd(),
        "episodes": episode_ids,
    }
    for key, value in (
        ("subject", subject), ("predicate", predicate), ("object", object_value),
        ("valid_from", valid_from), ("valid_to", valid_to),
        ("valid_from_commit", valid_from_commit), ("valid_to_commit", valid_to_commit),
        ("repo_revision", repo_revision), ("repo_path", repo_path),
    ):
        if value:
            record[key] = value
    if spec:
        record["validator"] = spec
    if merge_ids:
        record["merges"] = merge_ids
    near = [n for n in find_related(text) if n.split()[0] not in merge_ids]
    if near:
        record["near"] = near
    write_yaml(pending_dir(create=True) / f"{pid}.yml", record)
    append_event("assertion.proposed", pid, repo=final_repo, episodes=episode_ids)
    console.print(f"[green]Queued[/green] {pid} [dim]({provenance}, {confidence})[/dim]")
    if near:
        console.print(f"[dim]  near: {', '.join(near)}[/dim]")
    if merge_ids:
        console.print(f"[dim]  consolidates: {', '.join(merge_ids)} "
                      f"(retired on confirm)[/dim]")


@app.command("pending")
def cmd_pending(
    topic: Optional[str] = typer.Option(None, "--topic", "-t", help="Only candidates in this topic."),
    as_json: bool = typer.Option(False, "--json", help="Machine-readable output for review flows."),
    rejected: bool = typer.Option(False, "--rejected", help="Show the rejected log instead."),
    archived: bool = typer.Option(False, "--archived", help="Show candidates that aged out unreviewed."),
    count: bool = typer.Option(False, "--count", help="Print just the number of queued candidates."),
):
    """List candidate facts awaiting review. UNVETTED — leads, not facts."""
    rows = all_archived() if archived else all_rejected() if rejected else all_pending()
    if topic:
        topic_slug = slugify(topic, max_words=3)
        rows = [(pid, d) for pid, d in rows if d.get("topic") == topic_slug]

    if count:
        sys.stdout.write(f"{len(rows)}\n")
        return
    if as_json:
        sys.stdout.write(json.dumps([data for _, data in rows], indent=2) + "\n")
        return
    if not rows:
        console.print("[dim]No candidates pending review.[/dim]")
        return

    # fold, not ellipsize: a truncated id can't be pasted into `knowledge confirm`.
    table = Table(show_lines=True, header_style="bold")
    table.add_column("id", overflow="fold")
    table.add_column("prov", overflow="fold")
    table.add_column("conf")
    table.add_column("age", justify="right")
    table.add_column("text", overflow="fold", ratio=2)
    for pid, data in rows:
        age = days_ago(str(data.get("archived_at") or data.get("rejected_at")
                          or data.get("proposed_at", "")))
        style = "dim" if data.get("provenance") == "inferred" else ""
        table.add_row(
            pid,
            str(data.get("provenance", "")),
            str(data.get("confidence", "")),
            f"{age}d" if age >= 0 else "?",
            str(data.get("text", "")),
            style=style,
        )
    console.print(table)
    if archived:
        console.print(
            f"[dim]{len(rows)} archived candidate(s) — aged out before anyone reviewed them. "
            "Out of the duplicate corpus, so they can be re-proposed.[/dim]"
        )
    elif rejected:
        console.print(f"[dim]{len(rows)} rejected candidate(s). Rejections block re-proposal until pruned.[/dim]")
    else:
        console.print(
            f"[yellow]{len(rows)} UNVETTED candidate(s)[/yellow] — nobody has confirmed these. "
            "Treat as leads to verify, never as established fact.\n"
            "[dim]`knowledge confirm <id>` / `knowledge reject <id> -r '...'`[/dim]"
        )


@app.command("confirm")
def cmd_confirm(
    pending_id: str = typer.Argument(...),
    text: Optional[str] = typer.Option(None, "--text", help="Rewrite the fact before storing."),
    topic: Optional[str] = typer.Option(None, "--topic", "-t"),
    scope: Optional[str] = typer.Option(None, "--scope", "-s"),
    confidence: Optional[str] = typer.Option(None, "--confidence", "-c"),
    fact_id: Optional[str] = typer.Option(None, "--id", help="Store under a different ID."),
):
    """Promote a pending candidate into the store. Human-gated write."""
    src = pending_dir() / f"{pending_id}.yml"
    if not src.exists():
        err_console.print(f"[red]No such pending candidate:[/red] {pending_id}")
        raise typer.Exit(2)
    data = yaml.safe_load(src.read_text()) or {}

    final_text = text or str(data.get("text", ""))
    topic_slug = slugify(topic or str(data.get("topic", "")), max_words=3)
    final_scope = scope or str(data.get("scope") or default_scope())
    final_conf = confidence or str(data.get("confidence", "medium"))
    validate_scope(final_scope)
    validate_confidence(final_conf)

    fid = derive_id(topic_slug, final_text, fact_id) if (fact_id or text or topic) else pending_id
    if fact_path(fid).exists():
        err_console.print(f"[red]Already exists:[/red] {fid}.md — reject the candidate or confirm under --id <other>")
        raise typer.Exit(2)
    # A stored fact and a queued candidate sharing an id makes `get` ambiguous
    # and hides one of them from duplicate checks.
    if fid != pending_id and (pending_dir() / f"{fid}.yml").exists():
        err_console.print(f"[red]Id already held by a queued candidate:[/red] {fid} — "
                          f"resolve that candidate first, or confirm under --id <other>")
        raise typer.Exit(2)

    path = write_new_fact(
        fid,
        final_text,
        topic_slug,
        final_scope,
        final_conf,
        str(data.get("source", "")),
        provenance=str(data.get("provenance", "")) or None,
        repo=str(data.get("repo", "")),
        evidence=str(data.get("evidence", "")),
        subject=str(data.get("subject", "")),
        predicate=str(data.get("predicate", "")),
        object_value=str(data.get("object", "")),
        valid_from=str(data.get("valid_from", "")),
        valid_to=str(data.get("valid_to", "")),
        valid_from_commit=str(data.get("valid_from_commit", "")),
        valid_to_commit=str(data.get("valid_to_commit", "")),
        repo_revision=str(data.get("repo_revision", "")),
        repo_path=str(data.get("repo_path", "")),
        episodes=[str(x) for x in data.get("episodes") or []],
        validator=data.get("validator") if isinstance(data.get("validator"), dict) else None,
    )
    src.unlink()
    append_event("assertion.confirmed", fid, pending_id=pending_id)
    console.print(f"[green]Confirmed[/green] {fid} → {path}")

    for mid in data.get("merges") or []:
        mpath = fact_path(str(mid))
        if not mpath.exists():
            err_console.print(f"[yellow]  {mid}: already gone, not retired[/yellow]")
            continue
        post = frontmatter.load(mpath)
        if post.get("invalidated_at"):
            continue
        post["invalidated_at"] = today_iso()
        post["invalidation_reason"] = f"Consolidated into {fid}."
        mpath.write_text(frontmatter.dumps(post) + "\n")
        console.print(f"[dim]  retired {mid}[/dim]")


@app.command("reject")
def cmd_reject(
    pending_id: str = typer.Argument(...),
    reason: str = typer.Option(..., "--reason", "-r", help="Why it's not going in — blocks re-proposal."),
):
    """Drop a pending candidate. Kept in the rejected log so it isn't re-proposed."""
    src = pending_dir() / f"{pending_id}.yml"
    if not src.exists():
        err_console.print(f"[red]No such pending candidate:[/red] {pending_id}")
        raise typer.Exit(2)
    data = yaml.safe_load(src.read_text()) or {}
    data["rejected_at"] = today_iso()
    data["rejection_reason"] = reason
    write_yaml(rejected_dir(create=True) / f"{pending_id}.yml", data)
    src.unlink()
    console.print(f"[yellow]Rejected[/yellow] {pending_id}: {reason}")


@app.command("prune-pending")
def cmd_prune_pending(
    days: Optional[int] = typer.Option(None, "--days", "-d", help="Drop unreviewed candidates older than this."),
    rejected_days: Optional[int] = typer.Option(None, "--rejected-days", help="Drop rejected-log entries older than this."),
    dry_run: bool = typer.Option(False, "--dry-run"),
):
    """Age out candidates nobody reviewed and rejections old enough to re-litigate.

    Nothing is deleted: both kinds move to `pending/archived/`. A candidate
    aging out means review didn't keep up, and destroying text nobody ever
    judged on that basis loses work rather than settling it.
    """
    cfg = load_config()
    days = cfg["pending_prune_days"] if days is None else days
    rejected_days = cfg["rejected_prune_days"] if rejected_days is None else rejected_days

    def archive(data: dict, src: Path, ident: str, reason: str) -> None:
        data["archived_at"] = today_iso()
        data["archived_reason"] = reason
        write_yaml(archived_dir(create=True) / f"{ident}.yml", data)
        src.unlink()

    n = 0
    for pid, data in all_pending():
        age = days_ago(str(data.get("proposed_at", "")))
        if age >= days:
            console.print(f"[dim]archive pending[/dim] {pid} ({age}d)")
            if not dry_run:
                archive(data, pending_dir() / f"{pid}.yml", pid, f"unreviewed for {age}d")
            n += 1
    for rid, data in all_rejected():
        age = days_ago(str(data.get("rejected_at", "")))
        if age >= rejected_days:
            console.print(f"[dim]archive rejected[/dim] {rid} ({age}d)")
            if not dry_run:
                archive(data, rejected_dir() / f"{rid}.yml", rid, f"rejection aged out after {age}d")
            n += 1
    console.print(
        f"[dim]{n} entr(ies) {'would be ' if dry_run else ''}archived to {ARCHIVED_SUBDIR}/ "
        "— nothing deleted; `knowledge pending --archived` to review.[/dim]"
    )


@app.command("list")
def cmd_list(
    scope: Optional[str] = typer.Option(None, "--scope", "-s"),
    topic: Optional[str] = typer.Option(None, "--topic", "-t"),
    stale: bool = typer.Option(False, "--stale", help="Only facts unverified for longer than --days"),
    days: Optional[int] = typer.Option(None, "--days", "-d", help="Staleness threshold for --stale."),
    invalid: bool = typer.Option(False, "--invalid", help="Include invalidated facts."),
    no_pending: bool = typer.Option(False, "--no-pending", help="Hide unconfirmed candidates."),
):
    """List facts. Unconfirmed candidates appear inline with status 'unvetted'."""
    days = load_config()["stale_days"] if days is None else days
    table = Table(show_lines=False, header_style="bold")
    table.add_column("id", overflow="fold")  # ids get pasted into `get`/`confirm`; never truncate
    table.add_column("topic")
    table.add_column("scope")
    table.add_column("conf")
    table.add_column("verified")
    table.add_column("age", justify="right")
    table.add_column("status", overflow="fold")

    rows: list[tuple[str, list[str], str]] = []
    n_pending = 0
    if not (no_pending or stale or invalid):
        for pid, data in all_pending():
            if scope and data.get("scope") != scope:
                continue
            if topic and data.get("topic") != slugify(topic, max_words=3):
                continue
            age = days_ago(str(data.get("proposed_at", "")))
            rows.append((
                pid,
                [
                    pid,
                    str(data.get("topic", "")),
                    str(data.get("scope", "")),
                    str(data.get("confidence", "")),
                    "pending",
                    f"{age}d" if age >= 0 else "?",
                    "unvetted:infer" if data.get("provenance") == "inferred" else "unvetted:said",
                ],
                "yellow",
            ))
            n_pending += 1

    n = 0
    for fid, post in all_facts():
        if scope and post.get("scope") != scope:
            continue
        if topic and post.get("topic") != topic:
            continue
        invalidated = post.get("invalidated_at")
        if invalidated and not invalid:
            continue
        verified = post.get("last_verified_at", "")
        age = days_ago(verified) if verified else -1
        if stale and (age < 0 or age < days):
            continue

        status = "ok"
        style = ""
        if invalidated:
            status = f"invalid {invalidated}"
            style = "dim"
        elif str(post.get("epistemic_status") or "supported") != "supported":
            status = str(post.get("epistemic_status"))
            style = "red" if status == "refuted" else "yellow"
        elif (post.get("valid_to") or post.get("valid_until")) and days_ago(
            str(post.get("valid_to") or post.get("valid_until"))
        ) >= 0:
            status = "expired"
            style = "yellow"
        elif age > days:
            status = "stale"
            style = "yellow"

        rows.append((
            fid,
            [
                fid,
                post.get("topic", ""),
                post.get("scope", ""),
                post.get("confidence", ""),
                verified,
                f"{age}d" if age >= 0 else "?",
                status,
            ],
            style,
        ))
        n += 1

    for _, row, style in sorted(rows, key=lambda r: r[0]):
        table.add_row(*row, style=style)
    console.print(table)

    summary = f"[dim]{n} fact(s)[/dim]"
    if n_pending:
        summary += (
            f"  [yellow]+ {n_pending} unvetted[/yellow] [dim]— unconfirmed candidates, "
            "leads to verify rather than facts to cite. `knowledge get <id>` for the evidence.[/dim]"
        )
    console.print(summary)


@app.command("get")
def cmd_get(fact_id: str = typer.Argument(...)):
    """Print a fact (frontmatter + body). Falls back to the queue, clearly labelled."""
    p = fact_path(fact_id)
    if p.exists():
        log_usage("get", [fact_id])
        sys.stdout.write(p.read_text())
        return

    for kind, path in (("PENDING", pending_dir()), ("REJECTED", rejected_dir())):
        q = path / f"{fact_id}.yml"
        if q.exists():
            sys.stdout.write(
                f"### {kind} CANDIDATE — NOT A STORED FACT ###\n"
                "# Nobody has confirmed this. Use it as a lead to verify independently.\n"
                "# Do not cite it as established, and do not propose facts derived from it.\n\n"
            )
            log_usage("get", [fact_id], kind=kind.lower())
            sys.stdout.write(q.read_text())
            return

    for episode_id, data in all_episodes():
        if episode_id != fact_id:
            continue
        sys.stdout.write(
            "### UNTRUSTED EPISODE — EVIDENCE, NOT A STORED FACT ###\n"
            "# It may support, contradict, or merely mention an assertion.\n\n"
        )
        sys.stdout.write(yaml.safe_dump(data, sort_keys=False, allow_unicode=True))
        return

    err_console.print(f"[red]No such fact:[/red] {fact_id}")
    raise typer.Exit(2)


@app.command("search")
def cmd_search(
    query: str = typer.Argument(..., help="What you are looking for, in your own words."),
    limit: int = typer.Option(8, "--limit", "-n", help="How many hits to show."),
    pending: bool = typer.Option(False, "--pending", help="Include unvetted candidates, labelled."),
    full: bool = typer.Option(False, "--full", help="Print whole bodies instead of one line each."),
    repo: Optional[str] = typer.Option(None, "--repo", help="Repository context; defaults to cwd origin."),
    all_repos: bool = typer.Option(False, "--all-repos", help="Do not filter assertions about other repositories."),
    as_of: str = typer.Option("", "--as-of", help="Valid-time date, YYYY-MM-DD."),
    as_json: bool = typer.Option(False, "--json"),
):
    """Find the few facts that relate to a query.

    This exists so nothing has to dump the whole store to answer "is there
    anything on X?". `index` grows with every fact you confirm; a search does
    not. Scoring is the same tf-idf cosine the duplicate checker uses, so a hit
    here means the same thing a near-duplicate does.
    """
    if as_of:
        as_of = iso_date(as_of, "--as-of")
    query_repo = (repo if repo is not None else detect_repo()) or ""
    checkout = repo_checkout(query_repo) if query_repo else None
    entries: list[tuple[str, str, str, str, str]] = []  # kind,id,text,repo,status
    for fid, post in all_facts():
        if not assertion_retrievable(post, as_of):
            continue
        fact_repo = str(post.get("repo") or "")
        if query_repo and fact_repo and fact_repo != query_repo and not all_repos:
            continue
        if fact_repo == query_repo and not commit_applies(post, checkout):
            continue
        entries.append(("fact", fid, " ".join(post.content.split()), fact_repo,
                        fact_status(post) or "supported"))
    if pending:
        for pid, data in all_pending():
            fact_repo = str(data.get("repo") or "")
            if query_repo and fact_repo and fact_repo != query_repo and not all_repos:
                continue
            entries.append(("pending", pid, " ".join(str(data.get("text", "")).split()),
                            fact_repo, "unvetted"))
    if not entries:
        # --json must always be parseable, even when there is nothing to say
        if as_json:
            sys.stdout.write("[]\n")
        else:
            console.print("[dim]no facts to search[/dim]")
        return

    docs = [content_tokens(e[2]) for e in entries]
    q = content_tokens(query)
    idf = _idf(docs + [q])
    qv = _vec(q, idf)
    scored = sorted((((_cos(qv, _vec(d, idf)) * (1.15 if query_repo and e[3] == query_repo else 1.0)), e)
                     for d, e in zip(docs, entries)),
                    key=lambda r: -r[0])
    hits = [(sc, e) for sc, e in scored if sc > 0.0][:limit]

    if as_json:
        sys.stdout.write(json.dumps([
            {"id": e[1], "kind": e[0], "score": round(sc, 3), "text": e[2],
             "repo": e[3], "status": e[4]}
            for sc, e in hits], indent=2) + "\n")
        return
    if not hits:
        console.print(f"[dim]nothing matched '{query}'[/dim]")
        return
    for sc, (kind, fid, text, fact_repo, status) in hits:
        tag = "" if kind == "fact" else " [yellow](unvetted)[/yellow]"
        if status not in {"supported", "unvetted"}:
            tag += f" [yellow]({status})[/yellow]"
        body = text if full else (text[:150] + ("…" if len(text) > 150 else ""))
        where = f" [dim]{fact_repo}[/dim]" if fact_repo else ""
        console.print(f"[dim]{sc:.2f}[/dim] [bold]{fid}[/bold]{tag}{where}\n      {body}")
    console.print(f"[dim]{len(hits)} of {len(entries)} — `get <id>` for the full fact[/dim]")


@app.command("recall")
def cmd_recall(
    query: str = typer.Argument(..., help="Free text — usually a whole user prompt."),
    limit: int = typer.Option(3, "--limit", "-n", help="Max facts to return."),
    min_score: Optional[float] = typer.Option(None, "--min-score", help="Blended-score floor."),
    min_shared: Optional[int] = typer.Option(None, "--min-shared", help="Min distinctive query tokens a fact must share."),
    max_chars: int = typer.Option(400, "--max-chars", help="Truncate each fact body past this."),
    repo: Optional[str] = typer.Option(None, "--repo", help="Repository context; defaults to cwd origin."),
    all_repos: bool = typer.Option(False, "--all-repos", help="Do not filter assertions about other repositories."),
    as_of: str = typer.Option("", "--as-of", help="Valid-time date, YYYY-MM-DD."),
    as_json: bool = typer.Option(False, "--json"),
    quiet: bool = typer.Option(False, "--quiet", help="Print nothing when nothing clears the bar (hook mode)."),
):
    """Surface stored facts relevant to a query, for unattended injection.

    `search` is for a human who already suspects the answer is in here, so it
    ranks everything and shows the best few. `recall` runs on every prompt with
    nobody watching, so it is gated and returns nothing rather than something
    weak — see score_pairs() for why the gate is on tokens, not score.

    Confirmed facts only. Matching candidates are named but never printed:
    auto-injecting unvetted model output is the boundary the trust layers exist to
    hold.
    """
    cfg = load_config()
    min_score = thresh("recall_min_score") if min_score is None else min_score
    min_shared = int(cfg["recall_min_shared"]) if min_shared is None else min_shared
    query = (query or "")[:4000]
    if as_of:
        as_of = iso_date(as_of, "--as-of")
    query_repo = (repo if repo is not None else detect_repo()) or ""
    checkout = repo_checkout(query_repo) if query_repo else None

    facts = {}
    for fid, post in all_facts():
        if not assertion_retrievable(post, as_of):
            continue
        fact_repo = str(post.get("repo") or "")
        if query_repo and fact_repo and fact_repo != query_repo and not all_repos:
            continue
        if fact_repo == query_repo and not commit_applies(post, checkout):
            continue
        facts[fid] = post
    scored = score_pairs(query, [(fid, post.content) for fid, post in facts.items()])
    scored = [
        (sc * (1.15 if query_repo and str(facts[fid].get("repo") or "") == query_repo else 1.0),
         fid, distinct)
        for sc, fid, distinct in scored
    ]
    scored.sort(key=lambda row: -row[0])
    hits = [(sc, fid) for sc, fid, distinct in scored
            if sc >= min_score and distinct >= min_shared][:limit]

    if not hits:
        if as_json:
            sys.stdout.write(json.dumps({"query": query[:200], "hits": []}) + "\n")
        elif not quiet:
            console.print("[dim]Nothing in the store scored above the recall floor.[/dim]")
        log_usage("recall", [], query, n=0, hit=False)
        return

    log_usage("recall", [fid for _, fid in hits], query,
              n=len(hits), top=round(hits[0][0], 3), hit=True)

    if as_json:
        sys.stdout.write(json.dumps({"query": query[:200], "hits": [{
            "id": fid,
            "score": round(sc, 3),
            "topic": facts[fid].get("topic", ""),
            "scope": facts[fid].get("scope", ""),
            "repo": facts[fid].get("repo", ""),
            "confidence": facts[fid].get("confidence", ""),
            "epistemic_status": facts[fid].get("epistemic_status", "supported"),
            "last_verified_at": str(facts[fid].get("last_verified_at") or ""),
            "status": fact_status(facts[fid]) or "ok",
            "evidence": str(facts[fid].get("evidence") or ""),
            "text": facts[fid].content.strip(),
        } for sc, fid in hits]}, indent=2) + "\n")
        return

    # Plain stdout, not console.print: this text is injected into a prompt,
    # where rich's terminal-width wrapping would mangle it.
    out = [
        f"# Recalled facts ({len(hits)} of {len(facts)} stored, matched against this prompt)",
        "# Retrieval is similarity-based and NOT exhaustive — a thin result is not",
        "# evidence that nothing is stored. Use `search`/`index --topic` to go deeper.",
        "",
    ]
    for sc, fid in hits:
        post = facts[fid]
        bits = [str(post.get("topic") or "?"), str(post.get("scope") or "?"),
                f"confidence: {post.get('confidence') or '?'}",
                f"verified {post.get('last_verified_at') or '?'}"]
        if post.get("repo"):
            bits.insert(2, str(post.get("repo")))
        status = fact_status(post)
        if status:
            bits.append(status)
        out.append(f"[{sc:.2f}] {fid}  ({' · '.join(bits)})")
        body = (post.content or "").strip().replace("\r", "")
        if len(body) > max_chars:
            body = body[: max_chars - 1].rstrip() + "…"
        out.append(body)
        ev = str(post.get("evidence") or "").strip()
        if ev:
            out.append(f"  evidence: {ev[:200]}")
        if status:
            out.append(f"  ^ {status} — verify before relying on this; "
                       f"`knowledge verify {fid}` once re-checked.")
        out.append("")

    pending_pairs = [
        (pid, str(d.get("text", ""))) for pid, d in all_pending()
        if not query_repo or not d.get("repo") or d.get("repo") == query_repo or all_repos
    ]
    pending_hits = [pid for sc, pid, distinct in score_pairs(query, pending_pairs)
                    if sc >= min_score and distinct >= min_shared][:5]
    if pending_hits:
        out.append(f"# {len(pending_hits)} unvetted candidate(s) also matched — leads, not facts: "
                   f"{', '.join(pending_hits)}")
        out.append("# `knowledge get <id>` to read one. Never cite one as established.")
        out.append("")

    sys.stdout.write("\n".join(out))


@app.command("usage")
def cmd_usage(
    days: int = typer.Option(90, "--days", "-d", help="Window to report over."),
    limit: int = typer.Option(15, "--limit", "-n", help="Rows in the top table."),
    unread: bool = typer.Option(False, "--unread", help="List facts never surfaced in the window."),
    misses: bool = typer.Option(False, "--misses", help="List recall queries that matched nothing."),
):
    """Which facts actually get read. Prune by uselessness, not just by age."""
    rows = read_usage(days)
    if not rows:
        console.print(f"[dim]No usage recorded in the last {days}d. Reads are logged from "
                      "`recall`/`get`; set KNOWLEDGE_USAGE_LOG=0 to disable.[/dim]")
        return

    counts: dict[str, int] = {}
    by_action: dict[str, int] = {}
    recall_total = recall_hit = 0
    miss_queries: list[str] = []
    for r in rows:
        act = str(r.get("action", "?"))
        by_action[act] = by_action.get(act, 0) + 1
        if act == "recall":
            recall_total += 1
            if r.get("hit"):
                recall_hit += 1
            elif r.get("query"):
                miss_queries.append(str(r["query"]))
        for fid in r.get("ids", []) or []:
            counts[str(fid)] = counts.get(str(fid), 0) + 1

    live = [fid for fid, post in all_facts() if not post.get("invalidated_at")]
    never = [fid for fid in live if fid not in counts]

    if unread:
        for fid in sorted(never):
            sys.stdout.write(f"{fid}\n")
        return
    if misses:
        for q in miss_queries[-limit:]:
            sys.stdout.write(f"{q}\n")
        return

    table = Table(show_lines=False, header_style="bold")
    table.add_column("fact"); table.add_column("reads", justify="right")
    for fid, c in sorted(counts.items(), key=lambda kv: (-kv[1], kv[0]))[:limit]:
        table.add_row(fid, str(c))
    console.print(table)
    console.print(f"[dim]{len(rows)} event(s) over {days}d — "
                  f"{', '.join(f'{k}={v}' for k, v in sorted(by_action.items()))}[/dim]")
    if recall_total:
        pct = 100.0 * recall_hit / recall_total
        console.print(f"[dim]recall hit rate: {recall_hit}/{recall_total} ({pct:.0f}%) — low means "
                      "the floor is too high or the store is thin (`--misses` to see what missed).[/dim]")
    console.print(f"[dim]{len(never)} of {len(live)} fact(s) never surfaced in this window"
                  f"{' — `--unread` to list them' if never else ''}.[/dim]")


@app.command("index")
def cmd_index(
    topic: Optional[str] = typer.Option(None, "--topic", "-t", help="Only facts in this topic."),
    everything: bool = typer.Option(False, "--all", help="Dump every fact. Grows with the store."),
    max_chars: int = typer.Option(120, "--max-chars", help="Truncate oneliner past this width."),
):
    """Compact `<id>: <oneliner>` index. Needs --topic or --all: the full dump grows
    with the store and is usually the wrong tool — try `search` first."""
    if not topic and not everything:
        err_console.print("[yellow]`index` prints every fact and grows with the store.[/yellow]\n"
                          "Use `search <query>` to find something, `index --topic <t>` for one "
                          "topic, or `index --all` if you really want the whole dump.")
        raise typer.Exit(2)
    log_usage("index", topic=topic or "", everything=everything)
    for fid, post in all_facts():
        if post.get("invalidated_at"):
            continue
        if topic and str(post.get("topic", "")) != topic:
            continue
        body = (post.content or "").strip()
        first = re.split(r"(?<=[.!?])\s", body, maxsplit=1)[0] if body else ""
        first = first.replace("\n", " ").strip()
        if len(first) > max_chars:
            first = first[: max_chars - 1].rstrip() + "…"
        sys.stdout.write(f"{fid}: {first}\n")


@app.command("topics")
def cmd_topics(
    invalid: bool = typer.Option(False, "--invalid", help="Include invalidated facts in counts."),
    plain: bool = typer.Option(False, "--plain", help="Plain `topic (N)` lines, no IDs or color (for hook injection)."),
):
    """List topics with fact counts. Default rich view includes member IDs; --plain is one-line-per-topic."""
    by_topic: dict[str, list[str]] = {}
    for fid, post in all_facts():
        if post.get("invalidated_at") and not invalid:
            continue
        topic = str(post.get("topic") or "(none)")
        by_topic.setdefault(topic, []).append(fid)

    # Unvetted candidates get a marker, never a fact count. A topic that exists
    # only in the queue still shows up, at (0), so the lead is discoverable.
    queued: dict[str, int] = {}
    for _, data in all_pending():
        t = str(data.get("topic") or "(none)")
        queued[t] = queued.get(t, 0) + 1
        by_topic.setdefault(t, [])

    if not by_topic:
        if not plain:
            console.print("[dim]No topics.[/dim]")
        return
    if plain:
        for topic in sorted(by_topic):
            mark = f" +{queued[topic]} unvetted" if topic in queued else ""
            sys.stdout.write(f"{topic} ({len(by_topic[topic])}){mark}\n")
        return
    width = max(len(t) for t in by_topic)
    for topic in sorted(by_topic):
        ids = by_topic[topic]
        mark = f"  [yellow]+{queued[topic]} unvetted[/yellow]" if topic in queued else ""
        console.print(f"[bold]{topic:<{width}}[/bold]  [dim]({len(ids)})[/dim]{mark}  " + ", ".join(ids))
    console.print(f"\n[dim]{len(by_topic)} topic(s), {sum(len(v) for v in by_topic.values())} fact(s)[/dim]")


@app.command("verify")
def cmd_verify(fact_id: str = typer.Argument(...)):
    """Bump last_verified_at to today."""
    post = load_fact(fact_id)
    post["last_verified_at"] = today_iso()
    post["epistemic_status"] = "supported"
    post.metadata.pop("refuted_at", None)
    post.metadata.pop("refutation_reason", None)
    save_fact(fact_id, post)
    append_event("assertion.verified", fact_id)
    console.print(f"[green]Verified[/green] {fact_id} @ {post['last_verified_at']}")


@app.command("invalidate")
def cmd_invalidate(
    fact_id: str = typer.Argument(...),
    reason: str = typer.Option(..., "--reason", "-r"),
):
    """Mark a fact as no longer true. File stays for audit."""
    post = load_fact(fact_id)
    post["invalidated_at"] = today_iso()
    post["invalidation_reason"] = reason
    save_fact(fact_id, post)
    append_event("assertion.invalidated", fact_id, reason=reason)
    console.print(f"[yellow]Invalidated[/yellow] {fact_id}: {reason}")


@app.command("update")
def cmd_update(
    fact_id: str = typer.Argument(...),
    confidence: Optional[str] = typer.Option(None, "--confidence", "-c"),
    scope: Optional[str] = typer.Option(None, "--scope", "-s"),
    valid_until: Optional[str] = typer.Option(None, "--valid-until"),
    valid_from: Optional[str] = typer.Option(None, "--valid-from"),
    valid_to: Optional[str] = typer.Option(None, "--valid-to"),
    epistemic_status: Optional[str] = typer.Option(None, "--epistemic-status"),
    subject: Optional[str] = typer.Option(None, "--subject"),
    predicate: Optional[str] = typer.Option(None, "--predicate"),
    object_value: Optional[str] = typer.Option(None, "--object"),
    source: Optional[str] = typer.Option(None, "--source"),
):
    """Update frontmatter fields on an existing fact."""
    post = load_fact(fact_id)
    if confidence:
        validate_confidence(confidence)
        post["confidence"] = confidence
    if scope:
        validate_scope(scope)
        post["scope"] = scope
    if valid_until is not None:
        post["valid_until"] = valid_until or None
    if valid_from is not None:
        post["valid_from"] = iso_date(valid_from, "--valid-from") or None
    if valid_to is not None:
        post["valid_to"] = iso_date(valid_to, "--valid-to") or None
    if epistemic_status:
        validate_epistemic_status(epistemic_status)
        post["epistemic_status"] = epistemic_status
    for key, value in (("subject", subject), ("predicate", predicate), ("object", object_value)):
        if value is not None:
            post[key] = value or None
    if source:
        post["source"] = source
    save_fact(fact_id, post)
    append_event("assertion.updated", fact_id)
    console.print(f"[green]Updated[/green] {fact_id}")


@app.command("stale")
def cmd_stale(days: Optional[int] = typer.Option(None, "--days", "-d")):
    """List facts whose last_verified_at is older than --days."""
    days = load_config()["stale_days"] if days is None else days
    table = Table(show_lines=False, header_style="bold")
    table.add_column("id")
    table.add_column("verified")
    table.add_column("age", justify="right")
    n = 0
    for fid, post in all_facts():
        if post.get("invalidated_at"):
            continue
        v = post.get("last_verified_at", "")
        age = days_ago(v) if v else -1
        if age >= days:
            table.add_row(fid, v, f"{age}d")
            n += 1
    console.print(table)
    console.print(f"[dim]{n} stale fact(s) (>{days}d)[/dim]")


@app.command("rewrite")
def cmd_rewrite(
    fact_id: str = typer.Argument(...),
    text: str = typer.Option(..., "--text", help="Replacement body."),
    verified: bool = typer.Option(False, "--verified", help="Also bump last_verified_at to today."),
):
    """Replace a fact's body, keeping its id and frontmatter.

    Exists so merging duplicate facts does not require hand-editing files: the
    survivor of a merge keeps its id (nothing linking to it dangles) while its
    body grows to cover what the invalidated duplicates said.
    """
    path = fact_path(fact_id)
    if not path.exists():
        err_console.print(f"[red]No such fact:[/red] {fact_id}")
        raise typer.Exit(2)
    post = frontmatter.load(path)
    if post.get("invalidated_at"):
        err_console.print(f"[red]{fact_id} is invalidated[/red] — revive it before rewriting.")
        raise typer.Exit(2)
    post.content = "\n" + " ".join(text.split()) + "\n"
    if verified:
        post["last_verified_at"] = today_iso()
    path.write_text(frontmatter.dumps(post) + "\n")
    append_event("assertion.rewritten", fact_id, verified=verified)
    console.print(f"[green]Rewrote[/green] {fact_id}" + (" [dim](verified today)[/dim]" if verified else ""))


@app.command("config")
def cmd_config(
    path_only: bool = typer.Option(False, "--path", help="Print just the resolved store path."),
):
    """Show the resolved configuration and where each part came from."""
    cfg = load_config()
    if path_only:
        # One plain line, so clients can resolve the store the same way the CLI
        # does instead of re-implementing the precedence rules and drifting.
        sys.stdout.write(f"{knowledge_dir(must_exist=False)}\n")
        return
    store = knowledge_dir(must_exist=False)
    missing = "" if store.is_dir() else "  [red](does not exist)[/red]"
    console.print(f"[bold]store[/bold]        {store}{missing}")
    console.print(f"[bold]graph index[/bold]  {graph_index_path()} [dim](disposable projection)[/dim]")
    console.print(f"[bold]resolved by[/bold]  {cfg.get('_store_from')}")
    # Listed in merge order, so an unexpected value can be traced to a file.
    console.print(f"[bold]settings[/bold]     {cfg.get('_source')}")
    console.print(f"[bold]scopes[/bold]       {', '.join(str(x) for x in cfg.get('scopes') or []) or '(none)'}"
                  f"  + {', '.join(f'{p}:<value>' for p in cfg.get('prefixed_scopes') or [])}")
    t = Table(header_style="bold", show_edge=False)
    t.add_column("threshold"); t.add_column("value", justify="right")
    for k, v in cfg["thresholds"].items():
        t.add_row(k, f"{v}")
    console.print(t)
    classes = _entity_classes()
    if classes:
        console.print(f"[bold]entity guard[/bold] {len(classes)} class(es): "
                      + ", ".join(f"{n} ({len(p)} pattern{'s' if len(p) != 1 else ''})"
                                  for n, _, p in classes))
    else:
        console.print("[bold]entity guard[/bold] [yellow]inert[/yellow] — no `entities` configured")


@app.command("init")
def cmd_init(
    directory: Path = typer.Argument(Path("."), help="Where to write .knowledge.yml."),
    store: str = typer.Option("~/.local/share/knowledge", "--store", help="External store path; may be relative to the config file."),
    scopes: str = typer.Option("personal", "--scopes", help="Comma-separated literal scope values."),
    protocol: bool = typer.Option(True, "--protocol/--no-protocol",
        help="Also write AGENTS-knowledge.md, the capture protocol agents need."),
    force: bool = typer.Option(False, "--force", help="Overwrite an existing config."),
):
    """Create a .knowledge.yml, the store directory, and the agent protocol doc."""
    directory = directory.expanduser().resolve()
    cfg_path = directory / CONFIG_FILENAME
    if cfg_path.exists() and not force:
        err_console.print(f"[red]{cfg_path} already exists[/red] — pass --force to overwrite.")
        raise typer.Exit(2)

    literal = [x.strip() for x in scopes.split(",") if x.strip()] or ["personal"]
    raw_store = Path(store).expanduser()
    store_dir = raw_store.resolve() if raw_store.is_absolute() else (directory / raw_store).resolve()
    (store_dir / PENDING_SUBDIR).mkdir(parents=True, exist_ok=True)
    (store_dir / EPISODES_SUBDIR).mkdir(parents=True, exist_ok=True)

    cfg_path.write_text(f"""# knowledge store configuration. Discovered by walking up from the working
# directory, so any command run inside this tree uses these settings.

store: {store}

# Vocabulary for a fact's `scope:` field. Reject anything else, so the axis stays
# usable for filtering instead of drifting into free text.
scopes:
{chr(10).join(f"  - {x}" for x in literal)}
prefixed_scopes:
  - repo
  - task

# Run `knowledge tune` once you have a review history — it derives these from
# your own rejections instead of guessing. Until then these are starting values
# measured on a different corpus, which is to say: probably wrong for yours.
thresholds:
  duplicate_cosine: 0.55   # propose refuses at or above this
  related_cosine: 0.42     # below refusal: queue it, but record `near:`
  cluster_cosine: 0.38     # grouping cutoff for `dupes`
  duplicate_jaccard: 0.75  # legacy token-overlap gate; catches verbatim copies only

# Hard identifiers, used to veto a merge before similarity is consulted.
# Similarity metrics weight words by how common they are, so a shared sentence
# template drowns out the rare tokens carrying the meaning: "team X files work in
# the ABC project" and "team Y files work in the XYZ project" look near-identical
# to both tf-idf and embeddings. They are different facts.
#
# The rule is narrow on purpose: a merge is blocked only when each side names
# EXACTLY ONE identifier of a class and they differ. A fact naming one identifier
# is about it; a fact listing several is illustrating with them, and those must
# stay mergeable.
#
# Leave empty to disable the guard entirely.
entities: []
#  - name: ticket key
#    lowercase: false
#    patterns:
#      - '\\b([A-Z]{{2,6}})-\\d+\\b'
#  - name: email
#    lowercase: true
#    patterns:
#      - '\\b([a-z0-9][a-z0-9._-]{{1,40}})@'

# Read-only checkout roots used to resolve `owner/repo` for deterministic
# validation. All memory and graph state remains in the external store/cache.
repo_roots: []
graph_cache: ~/.cache/knowledge

stale_days: 90
pending_prune_days: 45
rejected_prune_days: 180
""")
    console.print(f"[green]Wrote[/green] {cfg_path}")
    console.print(f"[green]Store[/green] {store_dir}")

    if protocol:
        doc = directory / "AGENTS-knowledge.md"
        doc.write_text(PROTOCOL_DOC)
        console.print(f"[green]Wrote[/green] {doc} [dim](paste into AGENTS.md / CLAUDE.md)[/dim]")
    console.print("\n[dim]next: knowledge ingest … for raw evidence; knowledge propose … "
                  "for an assertion; knowledge sweep for deterministic revalidation[/dim]")


@app.command("tune")
def cmd_tune(
    target_miss: float = typer.Option(0.05, "--target-miss",
        help="Largest acceptable fraction of known duplicates the grouping may miss."),
    folds: int = typer.Option(5, "--folds", help="Cross-validation folds over clusters."),
    seed: int = typer.Option(7, "--seed", help="Fold shuffle seed, for reproducibility."),
    write: bool = typer.Option(False, "--write", help="Write the result into the config file."),
):
    """Derive similarity thresholds from your own review history, and validate them.

    Your rejected log is labelled data: a candidate rejected with a reason naming
    the fact it duplicated is a known-positive pair. Confirmed facts that were
    never merged into each other are known negatives. That is enough to measure
    what a threshold would actually have done, instead of guessing.
    """
    import random

    # ---- positives: rejections that name their survivor --------------------
    groups: dict[str, dict[str, str]] = {}
    for rid, data in all_rejected():
        m = re.search(r"duplicate of ([a-z0-9][a-z0-9._-]+)",
                      str(data.get("rejection_reason") or ""), re.I)
        if not m:
            continue
        text = " ".join(str(data.get("text", "")).split())
        if text:
            groups.setdefault(m.group(1).rstrip(".,;:"), {})[rid] = text
    labelled = {a: b for a, b in groups.items() if len(b) >= 2}
    if not labelled:
        console.print("[yellow]Not enough labelled data.[/yellow] `tune` learns from rejections "
                      "whose reason names the surviving fact, e.g. "
                      "--reason \"duplicate of <id>\". Reject a few duplicate clusters that way "
                      "and run this again.")
        raise typer.Exit(1)

    # ---- negatives: pairs of active facts nobody ever merged ---------------
    facts = {fid: " ".join(post.content.split())
             for fid, post in all_facts() if not post.get("invalidated_at")}

    idf = _idf([content_tokens(t) for v in labelled.values() for t in v.values()]
               + [content_tokens(t) for t in facts.values()])

    def best_edges(members: dict[str, str]) -> list[float]:
        """Each member's strongest link to a clustermate — what single linkage needs."""
        vecs = {i: _vec(content_tokens(t), idf) for i, t in members.items()}
        ids = list(vecs)
        return [max((_cos(vecs[i], vecs[j]) for j in ids if j != i), default=0.0) for i in ids]

    positives = [e for v in labelled.values() for e in best_edges(v)]
    fvecs = {i: _vec(content_tokens(t), idf) for i, t in facts.items()}
    fids = list(fvecs)
    negatives = [_cos(fvecs[fids[a]], fvecs[fids[b]])
                 for a in range(len(fids)) for b in range(a + 1, len(fids))]

    console.print(f"[bold]{len(positives)}[/bold] labelled duplicates in "
                  f"[bold]{len(labelled)}[/bold] clusters, from your rejected log")
    console.print(f"[bold]{len(negatives)}[/bold] negative pairs, from "
                  f"{len(facts)} active facts nobody merged\n")

    grid = [round(x / 100, 2) for x in range(20, 62, 2)]
    table = Table(header_style="bold")
    table.add_column("threshold", justify="right")
    table.add_column("duplicates missed", justify="right")
    table.add_column("miss rate", justify="right")
    table.add_column("false pairs", justify="right")
    table.add_column("false rate", justify="right")
    rows = []
    for t in grid:
        miss = sum(1 for e in positives if e < t)
        fp = sum(1 for x in negatives if x >= t)
        rows.append((t, miss, miss / len(positives), fp, fp / max(1, len(negatives))))
    for t, miss, rate, fp, fprate in rows:
        table.add_row(f"{t:.2f}", str(miss), f"{100*rate:.0f}%", str(fp), f"{100*fprate:.2f}%")
    console.print(table)

    # ---- cross-validate, so the number is not just an in-sample fit --------
    def fit(keys: list[str]) -> float:
        e = [x for kk in keys for x in best_edges(labelled[kk])]
        ok = [t for t in grid if sum(1 for v in e if v < t) / len(e) <= target_miss]
        return max(ok) if ok else grid[0]

    keys = sorted(labelled)
    n_folds = max(2, min(folds, len(keys)))
    random.Random(seed).shuffle(keys)
    parts = [keys[i::n_folds] for i in range(n_folds)]
    fitted, in_s, held = [], [], []
    for i in range(n_folds):
        test = parts[i]
        train = [x for j in range(n_folds) if j != i for x in parts[j]]
        if not train or not test:
            continue
        t = fit(train)
        tr = [x for kk in train for x in best_edges(labelled[kk])]
        te = [x for kk in test for x in best_edges(labelled[kk])]
        fitted.append(t)
        in_s.append(sum(1 for v in tr if v < t) / len(tr))
        held.append(sum(1 for v in te if v < t) / len(te))

    cluster_t = fit(sorted(labelled))
    if fitted:
        spread = f"{min(fitted):.2f}–{max(fitted):.2f}" if min(fitted) != max(fitted) \
            else f"stable at {min(fitted):.2f}"
        mean_in = sum(in_s) / len(in_s)
        mean_held = sum(held) / len(held)
        console.print(f"[bold]Cross-validation[/bold] ({len(fitted)} folds over clusters, "
                      f"fit on the rest, measured on the held-out fold)")
        console.print(f"  fitted threshold across folds: {spread}")
        console.print(f"  miss rate: {100*mean_in:.0f}% in-sample vs "
                      f"[bold]{100*mean_held:.0f}%[/bold] held out")
        gap = mean_held - mean_in
        if gap > 0.10:
            console.print(f"  [yellow]held-out is {100*gap:.0f} points worse — the fit is not "
                          f"generalising; treat the recommendation as optimistic[/yellow]")
        else:
            console.print("  [green]held-out matches in-sample — the threshold generalises[/green]")
        # prefer the cross-validated consensus when it is more conservative
        if fitted and min(fitted) > cluster_t:
            cluster_t = min(fitted)
        console.print()

    rel_t = round(min(0.95, cluster_t + 0.04), 2)
    dup_t = round(min(0.95, cluster_t + 0.17), 2)
    row = next(r for r in rows if r[0] == cluster_t)
    console.print(f"[bold]Recommendation[/bold]")
    console.print(f"  cluster_cosine   [green]{cluster_t:.2f}[/green]  "
                  f"misses {100*row[2]:.0f}% of known duplicates, "
                  f"{row[3]} false pair(s) ({100*row[4]:.2f}%)")
    console.print(f"  related_cosine   [green]{rel_t:.2f}[/green]")
    console.print(f"  duplicate_cosine [green]{dup_t:.2f}[/green]  "
                  f"[dim]held above grouping: refusing a candidate is destructive[/dim]")

    console.print(f"""
[bold]How this was measured[/bold] — the same checks are worth repeating yourself,
because a threshold fitted to one corpus says nothing about another:

  1. [bold]Positives from rejections.[/bold] Every candidate you rejected with a reason
     naming its survivor is a known duplicate. Group by survivor and you have
     real clusters, at no labelling cost.
  2. [bold]Score the max edge, not the mean.[/bold] Grouping is single linkage, so a
     member joins if it links to ANY clustermate. Averaging pair scores
     understates recall and will push you to a threshold that is too low.
  3. [bold]Negatives from unmerged facts.[/bold] Any two confirmed facts you never
     merged are a negative pair. A few may be duplicates you have not found,
     which makes the false-pair column slightly pessimistic — the safe direction.
  4. [bold]Cross-validate over clusters, not members.[/bold] Members of one cluster are
     near-copies; splitting them across folds leaks the answer and every
     threshold looks perfect. Hold out whole clusters.
  5. [bold]Read false PAIRS as a floor on review cost.[/bold] Single linkage chains, so a
     handful of extra edges can fuse two real groups into one large one. Check
     `dupes -T <threshold>` for cluster sizes before adopting a looser value.
""")

    if not write:
        console.print("[dim]re-run with --write to save these into the config file[/dim]")
        return
    cfg_path = Path(load_config().get("_source", ""))
    if not cfg_path.is_file():
        err_console.print("[red]No config file to write to.[/red] Run `knowledge init` first.")
        raise typer.Exit(2)
    data = yaml.safe_load(cfg_path.read_text()) or {}
    data.setdefault("thresholds", {})
    data["thresholds"].update({"cluster_cosine": cluster_t,
                               "related_cosine": rel_t,
                               "duplicate_cosine": dup_t})
    cfg_path.write_text(yaml.safe_dump(data, sort_keys=False, allow_unicode=True))
    console.print(f"[green]Wrote[/green] thresholds to {cfg_path}")


@app.command("dupes")
def cmd_dupes(
    threshold: Optional[float] = typer.Option(None, "--threshold", "-T", help="tf-idf cosine cutoff for single-linkage grouping."),
    include_store: bool = typer.Option(False, "--include-store", help="Also cluster confirmed facts, to catch store-vs-queue overlap."),
    as_json: bool = typer.Option(False, "--json", help="Machine-readable, for the review UI."),
    min_size: int = typer.Option(2, "--min-size", help="Only report groups at least this large."),
):
    """Group near-duplicate candidates so review can decide once per cluster."""
    if threshold is None:
        threshold = thresh("cluster_cosine")
    items: list[tuple[str, str]] = []
    meta: dict[tuple[str, str], dict] = {}
    for pid, data in all_pending():
        text = " ".join(str(data.get("text", "")).split())
        items.append((("pending", pid), text))
        meta[("pending", pid)] = {
            "id": pid,
            "kind": "pending",
            "text": text,
            "topic": data.get("topic", ""),
            "scope": data.get("scope", ""),
            "confidence": data.get("confidence", ""),
            "provenance": data.get("provenance", ""),
            "evidence": data.get("evidence", ""),
            "source": data.get("source", ""),
            "proposed_at": str(data.get("proposed_at", "")),
            "repo": data.get("repo", ""),
            "cwd": data.get("cwd", ""),
        }
    if include_store:
        for fid, post in all_facts():
            if post.get("invalidated_at"):
                continue
            text = " ".join(post.content.split())
            items.append((("fact", fid), text))
            meta[("fact", fid)] = {
                "id": fid,
                "kind": "fact",
                "text": text,
                "topic": post.get("topic", ""),
                "scope": post.get("scope", ""),
                "confidence": post.get("confidence", ""),
                "provenance": post.get("provenance", ""),
                "evidence": "",
                "source": post.get("source", ""),
                "proposed_at": str(post.get("learned_at", "")),
                "repo": post.get("repo", ""),
                "cwd": "",
            }

    if not items:
        if as_json:
            sys.stdout.write(json.dumps({"threshold": threshold, "total": 0, "clusters": []}) + "\n")
        else:
            console.print("[dim]nothing to cluster[/dim]")
        return

    groups = cluster_texts([(k[1], t) for k, t in items], threshold)
    sims = getattr(cluster_texts, "last_sims", {})

    clusters = []
    for gi, g in enumerate(groups):
        if len(g) < min_size:
            continue
        keys = [items[i][0] for i in g]
        members = [meta[k] for k in keys]
        if len(g) > 1:
            central = {
                i: sum(sims.get((min(i, j), max(i, j)), 0.0) for j in g if j != i)
                for i in g
            }
            rep = items[max(central, key=central.get)][0][1]
        else:
            rep = keys[0][1]
        pairs = [
            {"a": items[i][0][1], "b": items[j][0][1], "sim": round(sims[(i, j)], 3)}
            for i in g for j in g if i < j and (i, j) in sims
        ]
        clusters.append({
            "key": f"c{gi:03d}",
            "size": len(g),
            "rep": rep,
            "has_user_stated": any(m["provenance"] == "user-stated" for m in members),
            "has_stored_fact": any(m["kind"] == "fact" for m in members),
            "topics": sorted({str(m["topic"]) for m in members}),
            "flags": numeric_conflicts([m["text"] for m in members]) if len(members) > 1 else [],
            "max_sim": round(max((p["sim"] for p in pairs), default=1.0), 3),
            "pairs": sorted(pairs, key=lambda x: -x["sim"])[:12],
            "members": sorted(members, key=lambda m: (m["provenance"] != "user-stated", m["id"])),
        })

    covered = sum(c["size"] for c in clusters)
    payload = {
        "threshold": threshold,
        "total": len(items),
        "pending_total": sum(1 for m in meta.values() if m["kind"] == "pending"),
        "cluster_count": len(clusters),
        "covered": covered,
        "clusters": clusters,
    }

    if as_json:
        sys.stdout.write(json.dumps(payload, indent=2) + "\n")
        return

    for c in clusters:
        head = f"[bold]{c['key']}[/bold]  n={c['size']}  max_sim={c['max_sim']}  topics={','.join(c['topics'])}"
        if c["has_user_stated"]:
            head += "  [yellow](contains user-stated)[/yellow]"
        if c["has_stored_fact"]:
            head += "  [cyan](contains stored fact)[/cyan]"
        console.print(head)
        for f in c["flags"]:
            console.print(f"  [yellow]!! {f}[/yellow]")
        for m in c["members"]:
            mark = "U" if m["provenance"] == "user-stated" else ("S" if m["kind"] == "fact" else " ")
            star = "*" if m["id"] == c["rep"] else " "
            console.print(f"  {mark}{star} [dim]{m['id']}[/dim] {m['text'][:110]}")
        console.print()
    console.print(f"[dim]{len(clusters)} cluster(s) covering {covered} of {len(items)} item(s) at cosine >= {threshold}[/dim]")


if __name__ == "__main__":
    app()
